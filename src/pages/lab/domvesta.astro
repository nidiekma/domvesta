---
// Sandbox: Domvesta landing in the visual language of /lab/optimind (the
// Skvortsov-concept recreation). Copy: docs/copy_v3.md, nothing else.
// Self-contained on purpose: no global.css, no site layout, not linked from
// anywhere, noindex.
//
// A pinned, full-viewport stage scrubs the opening like Optimind, minus its
// intro panel: one orb hero (headline left, lede + CTA right) → the benefit
// panel wipes up with its cards and embossed icons already in place.
// Everything after that scrolls normally in the same grey/amber/wide-type style.
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/schibsted-grotesk/400.css";

const TOTAL = "009";
const mail = "info@domvesta.de";
const cta = `mailto:${mail}?subject=${encodeURIComponent("Unverbindliches Erstgespräch")}`;

const benefits = [
  {
    icon: "document",
    title: "Verwaltung entlasten",
    text: "Verträge bündeln, Unterlagen digital abrufen und alltägliche Vorgänge vereinfachen.",
  },
  {
    icon: "trend",
    title: "Kosten optimieren",
    text: "Sonderkonditionen prüfen und Einsparpotenziale erkennen – mit Leistungen und Vertragsbedingungen im Blick.",
  },
  {
    icon: "person",
    title: "Persönlich betreut bleiben",
    text: "Bei Fragen, Veränderungen oder neuen Liegenschaften ist Domvesta Ihre zentrale Anlaufstelle.",
  },
];

const energy = [
  {
    title: "Dokumente griffbereit",
    text: "Verträge, Jahresabrechnungen und weitere Unterlagen je Lieferstelle einsehen.",
  },
  {
    title: "Vorgänge digital erledigen",
    text: "Zählerstände melden und SEPA-Lastschriftmandate einrichten.",
  },
  {
    title: "Neue Liegenschaften integrieren",
    text: "Weitere Objekte in die bestehende Vertrags- und Portalstruktur aufnehmen.",
  },
];

const insurance = [
  {
    title: "Kosten senken und Leistungen verbessern",
    text: "Wir prüfen, wo günstigere Beiträge möglich sind und wie sich Ihr Versicherungsschutz optimieren lässt.",
  },
  {
    title: "Schäden und Unterlagen digital bearbeiten",
    text: "Digitale Schadenmeldungen, Dokumente und Abrechnungen erleichtern die Verwaltung. Je nach Versicherungspartner unterstützen auch KI-gestützte Lösungen das Schadenmanagement.",
  },
  {
    title: "Weitere Immobilien aufnehmen",
    text: "Wir begleiten die Einbindung neuer Liegenschaften in den Rahmenvertrag und klären Voraussetzungen und Versicherungsschutz mit dem Versicherer.",
  },
];

const questions = [
  "Festpreis für Planungssicherheit oder ein flexibles Preismodell?",
  "Welche Versicherungsleistungen sind für Ihren Bestand sinnvoll?",
  "Und welcher Anbieter erleichtert tatsächlich Ihre Abläufe?",
];

const steps = [
  { title: "Kennenlernen", text: "Wir sprechen über Ihren Bestand, Ihre bisherigen Abläufe und Ihre Ziele." },
  { title: "Vergleichen", text: "Wir sichten Ihre Unterlagen und stellen passende Angebote verständlich gegenüber." },
  {
    title: "Umsetzen und begleiten",
    text: "Nach Ihrer Entscheidung und den erforderlichen Freigaben begleiten wir die Umstellung – und bleiben für die laufende Betreuung ansprechbar.",
  },
];

const faq = [
  {
    q: "Welche Unterlagen benötigen Sie?",
    a: "Für den Einstieg helfen aktuelle Energieabrechnungen, Verträge und eine Lieferstellenübersicht. Im Versicherungsbereich benötigen wir die vorhandenen Policen und relevante Objekt- und Schadendaten. Was im Einzelnen erforderlich ist, stimmen wir mit Ihnen ab.",
  },
  {
    q: "Müssen alle Verträge gleichzeitig wechseln?",
    a: "Nein. Wir berücksichtigen Laufzeiten und Kündigungsfristen. Ihr Bestand kann schrittweise in die neue Lösung überführt werden.",
  },
  {
    q: "Können neue Liegenschaften später dazukommen?",
    a: "Ja. Wir begleiten die Aufnahme in die bestehende Rahmenvertragslösung und klären die jeweiligen Konditionen und Voraussetzungen mit dem Anbieter.",
  },
  {
    q: "Ist eine Kostenersparnis garantiert?",
    a: "Nein. Wir prüfen Ihre Ausgangssituation und zeigen, welche Verbesserungen möglich sind. Neben dem Preis zählen dabei auch Versicherungsschutz, Vertragsbedingungen und Verwaltungsaufwand.",
  },
  {
    q: "Wer kümmert sich nach dem Abschluss?",
    a: "Domvesta bleibt Ihre persönliche Anlaufstelle. Wir unterstützen Sie bei Rückfragen und Veränderungen sowie bei der Abstimmung mit den Anbietern. Über Versicherungsleistungen und Schadenregulierung entscheidet der Versicherer.",
  },
