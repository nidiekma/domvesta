---
// ============================================================================
// Domvesta Scroll-World (Experiment) — /welt
// ----------------------------------------------------------------------------
// Scroll-gescrubbter Kameraflug durch eine Papercraft-Dioramenwelt. Die Kamera
// taucht in jede Szene hinein und fliegt über einen Connector-Clip nahtlos in
// die nächste — keine Schnitte.
//
// Bewusst eine EIGENE Route: index.astro, Teamfoto, Gründer und der
// ProvenExpert-Beleg bleiben unangetastet (PRODUCT.md, Prinzip 2 — Vertrauen
// entsteht durch echte Menschen, nicht durch generierte Bilder).
//
// Texte stammen 1:1 aus src/data/site.ts (kundenfreigegebene Formulierungen),
// nicht neu erfunden. Assets: public/scrollworld/.
// Engine: public/scrollworld/scrub-engine.js (vanilla, framework-agnostisch).
// ============================================================================
import "../styles/global.css";
import { site } from "../data/site.ts";

const V = "/scrollworld/vid";

const config = {
  brand: { name: site.name, href: "/" },
  diveScroll: 1.3,
  connScroll: 0.9,
  // Die Connector-Clips wurden auf den Frame bei -0,15 s des jeweiligen Dives
  // konditioniert — bei 24 fps fehlen an der Naht also ~3 Frames Kamerabewegung.
  // Etwas breiterer Crossfade als der Default (0.12) blendet genau das weg.
  crossfade: 0.18,
  hint: "Scrollen für die Tour",
  nav: true,
  atmosphere: true,
  sections: [
    {
      id: "liegenschaften",
      label: "Ihr Bestand",
      still: "/scrollworld/liegenschaften.webp",
      clip: `${V}/liegenschaften.mp4`,
      accent: "#e8651b",
      eyebrow: "Für Hausverwaltungen",
      title: "Alter Verwalter, ist das einfach!",
      body: "Keine zehn Ansprechpartner mehr für Energie & Versicherung. Nur noch einer — persönlich, digital und zuverlässig.",
      tags: ["Strom & Gas", "Versicherungen"],
    },
    {
      id: "papierkram",
      label: "Der Aufwand",
      still: "/scrollworld/papierkram.webp",
      clip: `${V}/papierkram.mp4`,
      accent: "#6b5742",
      eyebrow: "Das Problem",
      title: "Zehn Ansprechpartner. Eine Aufgabe.",
      body: "Unterschiedliche Energieversorger, unübersichtliche Verträge und fehlerhafte Abrechnungen kosten Hausverwaltungen täglich Zeit und Nerven.",
      tags: ["Verträge", "Abrechnungen", "Zeitfresser"],
    },
    {
      id: "energie",
      label: "Strom & Gas",
      still: "/scrollworld/energie.webp",
      clip: `${V}/energie.mp4`,
      accent: "#e8651b",
      scroll: 1.6,
      linger: 0.42,
      eyebrow: "Strom & Gas",
      title: "Verwalten war gestern.",
      body: "Unser digitales Lieferstellenportal bündelt sämtliche Strom- und Gasverträge Ihrer Liegenschaften.",
      tags: ["Preisprüfung", "Rahmenverträge", "Lieferstellenportal"],
    },
    {
      id: "versicherung",
      label: "Versicherungen",
      still: "/scrollworld/versicherung.webp",
      clip: `${V}/versicherung.mp4`,
      accent: "#1f4e8c",
      scroll: 1.6,
      linger: 0.42,
      eyebrow: "Versicherungen",
      title: "Papierkram war gestern.",
      body: "Wir übernehmen die Betreuung Ihrer Wohngebäude- und Grundbesitzerhaftpflicht — inklusive Schadensmanagement.",
      tags: ["Rahmenverträge", "Vertragsmanagement", "Schadensmanagement"],
    },
    {
      id: "gespraech",
      label: "Erstgespräch",
      still: "/scrollworld/gespraech.webp",
      clip: `${V}/gespraech.mp4`,
      accent: "#e8651b",
      scroll: 1.8,
      linger: 0.5,
      eyebrow: "Ein Ansprechpartner",
      title: "Mehr Zeit für Hausverwaltungen.",
      body: "Energie & Versicherung aus einer Hand. Lernen wir uns in einem unverbindlichen Gespräch kennen.",
      tags: [`${site.rating.score} / ${site.rating.max} auf ${site.rating.platform}`],
      cta: {
        primary: { label: "Erstgespräch buchen", href: site.calendlyUrl },
        secondary: { label: "Zur Website", href: "/" },
      },
    },
  ],
  connectors: [
    `${V}/conn1.mp4`,
    `${V}/conn2.mp4`,
    `${V}/conn3.mp4`,
    `${V}/conn4.mp4`,
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: die Engine nutzt env(safe-area-inset-*) für Notch/Home-Indicator -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <title>{site.name} — Eine Welt zum Durchscrollen</title>
    <meta
      name="description"
      content={`${site.name}: Scrollen Sie durch die Welt der Hausverwaltung — von den Liegenschaften über Strom & Gas bis zur Versicherung. Ein Ansprechpartner für alles.`}
    />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <div id="world"></div>

    <style is:global>
      /* Theme-Tokens der Engine auf die Domvesta-Palette (DESIGN.md) mappen.
         Unlayered :root gewinnt gegen @layer sw der Engine — keine !important nötig. */
      :root {
        --sw-bg: #fbf2e4;
        --sw-ink: #2a1c10;
        --sw-ink-soft: #6b5742;
        --sw-accent: #e8651b;
        --sw-font-display: "Instrument Serif", Georgia, serif;
        --sw-font-body: "Schibsted Grotesk", system-ui, sans-serif;
      }
      html,
      body {
        margin: 0;
        background: var(--sw-bg);
      }
      /* Die Engine scrubbt currentTime aus der Scroll-Position — natives Smooth-
         Scrolling (global.css) würde dabei nachlaufen. */
      html {
        scroll-behavior: auto;
      }
    </style>

    <script is:inline src="/scrollworld/scrub-engine.js"></script>
    <script
      is:inline
      set:html={`mountScrollWorld(document.getElementById('world'), ${JSON.stringify(config)});`}
    />
  </body>
</html>
