        align-items: center;
        gap: 0.9em;
        padding: 0.85em 0.9em;
        border-radius: 0.8em;
        font-weight: 500;
      }
      .pd-nav li.active {
        color: var(--orange-text);
        background: rgb(250 100 27 / 0.1);
        box-shadow: inset 3px 0 var(--orange);
      }
      .pd-nav .pd-sep {
        height: 1px;
        margin: 0.6em 0.9em;
        padding: 0;
        background: var(--line);
      }
      .pd-card {
        padding: 0.3em 1em 0.5em;
        border-left: 3px solid var(--orange);
        border-radius: 0.8em;
        background: #fff;
        box-shadow: 0 8px 18px -12px rgb(25 22 37 / 0.3);
      }
      .pd-head {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 0.7em;
        padding: 0.85em 0;
        border-bottom: 1px solid var(--line);
        font-size: 1.08em;
        font-weight: 500;
        color: var(--orange-text);
      }
      .pd-head :global(.ic-sm:first-child) {
        color: var(--ink);
      }
      .pd-card ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .pd-card li {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 0.9em;
        padding: 0.75em 0.2em;
      }
      .pd-card li + li {
        border-top: 1px solid rgb(217 208 196 / 0.6);
      }
      .pd-help-body {
        display: grid;
        grid-template-columns: 40% 1fr;
        align-items: center;
        gap: 0.8em;
        padding: 0.9em 0 0.5em;
      }
      .pd-help-body :global(.ic) {
        width: 100%;
        height: auto;
        stroke-width: 1.7;
      }
      .pd-help-body p {
        margin: 0;
        font-size: 0.92em;
        line-height: 1.45;
        color: var(--muted);
      }
      .rows {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--line);
      }
      .row {
        display: grid;
        grid-template-columns: 5vw 1fr;
        gap: 1vw;
        padding: 3.6svh 0;
        border-bottom: 1px solid var(--line);
      }
      .row h3 {
        margin-bottom: 1.2svh;
        font-size: clamp(17px, 1.45vw, 24px);
      }
      .row p,
      .tile p {
        margin: 0;
        max-width: 36em;
        font-size: clamp(13px, 0.95vw, 16px);
        line-height: 1.6;
        color: var(--muted);
      }
      /* Narrow desktops/tablets: the dashboard needs the full width. */
      @media (max-width: 1180px) {
        .energy {
          grid-template-columns: 1fr;
          row-gap: 7svh;
        }
      }
      .tasks {
        list-style: none;
        display: grid;
        gap: 1.6svh;
        margin: 2.4svh 0 0;
        padding: 0;
      }
      .tasks li {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: clamp(13px, 0.95vw, 16px);
        color: var(--muted);
      }
      .tasks :global(.ic) {
        width: 24px;
        height: 24px;
        color: var(--ink);
      }

      /* 04: Versicherungen */
      .tiles {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2vw;
        margin-top: 8svh;
      }
      .tile {
        display: grid;
        grid-template-areas: "num" "icon" "copy";
        /* Tiles stretch to the tallest one; keep the rows at the top so the
           titles line up. */
        align-content: start;
        justify-items: start;
        row-gap: 3svh;
        padding: 3.6svh 2vw 4svh;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: #fff;
      }
      .tile .row-num {
        grid-area: num;
      }
      .tile-icon {
        grid-area: icon;
      }
      .tile-copy {
        grid-area: copy;
      }
      .tile h3 {
        margin-bottom: 1.2svh;
        font-size: clamp(17px, 1.4vw, 23px);
      }
      .claim {
        position: relative;
        margin: 8svh 0 0;
        padding: 5svh 3vw 5svh calc(3vw + 26px);
        border-radius: 16px;
        background: rgb(217 208 196 / 0.32);
      }
      .claim::before {
        content: "";
        position: absolute;
        left: 3vw;
        top: 5svh;
        bottom: 5svh;
        width: 3px;
        border-radius: 2px;
        background: var(--orange);
      }
      .claim-title {
        margin: 0 0 2svh;
        font: 400 clamp(18px, 1.9vw, 32px) / 1.15 "Archivo Variable", sans-serif;
        font-stretch: 125%;
        text-transform: uppercase;
        color: var(--ink);
      }
      .claim p {
        margin: 0;
        max-width: 40em;
        font-size: clamp(14px, 1.1vw, 18px);
        line-height: 1.55;
        color: var(--muted);
      }

      /* 05: dark decision section, night navy with the orange glow */
      .dark {
        overflow: hidden;
        background: linear-gradient(160deg, #262236 0%, #191625 50%, #110f1a 100%);
        color: #fff;
        border-top: 0;
      }
      .dark > .count {
        color: rgb(255 255 255 / 0.5);
      }
      .dark-glow {
        position: absolute;
        right: -10vw;
        top: 10%;
        width: 60vw;
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(closest-side, rgb(250 100 27 / 0.32), rgb(250 100 27 / 0.08) 55%, transparent);
        filter: blur(20px);
        pointer-events: none;
      }
      .dark-head {
        position: relative;
        display: grid;
        grid-template-columns: 46% 1fr;
        column-gap: 2vw;
        align-items: end;
      }
      .dark-head .lede {
        margin: 0;
        color: rgb(255 255 255 / 0.85);
      }
      .choices {
        position: relative;
        list-style: none;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0 2vw;
        margin: 8svh 0 0;
        padding: 0;
        border-top: 1px solid rgb(255 255 255 / 0.16);
      }
      .choices li {
        padding-top: 4svh;
      }
      .choice-num {
        display: block;
        margin-bottom: 2.4svh;
        font: 400 clamp(34px, 3.4vw, 58px) / 1 "Archivo Variable", sans-serif;
        font-stretch: 110%;
        color: #fc9a64;
      }
      .choices h3 {
        margin-bottom: 1.4svh;
        font-size: clamp(17px, 1.45vw, 24px);
      }
      .choices p {
        margin: 0;
        max-width: 26em;
        font-size: clamp(14px, 1.05vw, 17px);
        line-height: 1.6;
        color: rgb(255 255 255 / 0.78);
      }
      .glow-text {
        position: relative;
        margin: 8svh 0 0;
        padding-top: 4svh;
        border-top: 1px solid rgb(255 255 255 / 0.16);
        font-size: clamp(18px, 1.6vw, 26px);
        line-height: 1.4;
        color: var(--orange);
        text-shadow: 0 0 24px rgb(250 110 40 / 0.4);
      }

      /* 06: team */
      .team-grid {
        display: grid;
        grid-template-columns: 46% 1fr;
        grid-template-rows: auto 1fr;
        column-gap: 4vw;
        row-gap: 4svh;
      }
      .team-grid > h2 {
        grid-column: 2;
        grid-row: 1;
        align-self: end;
      }
      .team-photo {
        grid-column: 1;
        grid-row: 1 / span 2;
        align-self: center;
        position: relative;
        margin: 0;
        aspect-ratio: 1.2;
        border-radius: 20px;
        overflow: hidden;
        background: #f1eae2; /* the photo's own backdrop */
        border: 1px solid rgb(25 22 37 / 0.12);
      }
      /* Square studio photo, cropped from the top so the heads keep
         their headroom. */
      .team-photo img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 0%;
      }
      /* Rings over the photo, multiplied: they show on the light backdrop and
         vanish over hair and the dark suits, so they read as sitting behind
         the two. The lower part fades out before the white shirts. */
      .team-rings {
        position: absolute;
        z-index: 1;
        inset: 0;
        --cy: 64%;
        mix-blend-mode: multiply;
        pointer-events: none;
        -webkit-mask-image: linear-gradient(to bottom, #000 42%, transparent 62%);
        mask-image: linear-gradient(to bottom, #000 42%, transparent 62%);
      }
      .team-rings span:first-child {
        width: 104%;
        border: 1.5px solid rgb(250 100 27 / 0.75);
      }
      .team-rings span:last-child {
        width: 86%;
        border: 1px solid rgb(25 22 37 / 0.3);
      }
      .team-copy {
        grid-column: 2;
        grid-row: 2;
      }
      .team-copy .lede {
        max-width: 30em;
        margin: 0 0 4svh;
      }
      .people {
        display: grid;
        gap: 12px;
      }
      .person {
        border: 1px solid var(--line);
        border-radius: 14px;
        background: #fff;
      }
      .person summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2vw;
        padding: 2.4svh 1.6vw;
        cursor: pointer;
        list-style: none;
      }
      .person summary::-webkit-details-marker {
        display: none;
      }
      /* First name only, in the body font: personal, not a label. */
      .person-name {
        display: block;
        font-size: clamp(16px, 1.25vw, 21px);
        font-weight: 500;
        line-height: 1.2;
        color: var(--ink);
      }
      .person-role {
        display: block;
        margin-top: 6px;
        font-size: clamp(13px, 0.9vw, 15px);
        color: var(--muted);
      }
      .person :global(.chev) {
        width: 20px;
        height: 20px;
        color: var(--ink);
        transition: rotate 0.3s;
      }
      .person[open] :global(.chev) {
        rotate: 90deg;
      }
      .person ul {
        margin: 0;
        padding: 0 1.6vw 2.4svh calc(1.6vw + 1.1em);
        font-size: clamp(13px, 0.92vw, 15px);
        line-height: 1.6;
        color: var(--muted);
      }
      .person li::marker {
        color: var(--orange);
      }
      .team-note {
        margin: 3.4svh 0 2.6svh;
        font-size: clamp(14px, 1.05vw, 17px);
        color: var(--ink);
      }
      .trust {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 3vw;
        margin-top: 10svh;
        padding: 3.6svh 2.4vw;
        border-radius: 16px;
        background: var(--ink);
        color: #fff;
      }
      .trust h3 {
        font-size: clamp(16px, 1.35vw, 22px);
        font-weight: 400;
        margin-bottom: 1svh;
      }
      .trust p {
        margin: 0;
        max-width: 40em;
        font-size: clamp(13px, 0.95vw, 15px);
        line-height: 1.6;
        color: rgb(255 255 255 / 0.72);
      }
      .trust .btn {
        flex: none;
      }
      .trust .btn-line {
        color: #fff;
        border-color: rgb(255 255 255 / 0.5);
      }
      .trust .btn-line:hover {
        color: var(--ink);
        background: #fff;
      }

      /* 07: steps, a horizontal timeline on desktop */
      .steps {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2vw;
        margin: 9svh 0 0;
        padding: 0;
      }
      .step {
        position: relative;
        padding-top: 5svh;
      }
      .step::before,
      .step::after {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        height: 2px;
      }
      .step::before {
        right: 0;
        background: var(--line);
      }
      .step::after {
        width: 0;
        background: linear-gradient(90deg, #fc9a64, var(--orange));
        box-shadow: 0 0 10px 1px rgb(250 100 27 / 0.45);
        transition: width 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--d, 0) * 0.25s + 0.2s);
      }
      .step.in::after {
        width: 100%;
      }
      .step-dot {
        position: absolute;
        z-index: 1;
        left: 0;
        top: 1px;
        width: 12px;
        height: 12px;
        translate: 0 -50%;
        border-radius: 50%;
        background: var(--ink);
      }
      .step .big-num {
        display: block;
        margin-bottom: 2.4svh;
      }
      .step h3 {
        margin-bottom: 1.4svh;
        font-size: clamp(17px, 1.45vw, 24px);
      }
      .step p {
        margin: 0;
        max-width: 30em;
        font-size: clamp(13px, 0.95vw, 16px);
        line-height: 1.6;
        color: var(--muted);
      }
      .roles {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        align-items: end;
        gap: 2vw;
        margin-top: 9svh;
        padding-top: 4svh;
        border-top: 1px solid var(--line);
      }
      .role-label {
        display: block;
        margin-bottom: 1.2svh;
        font: 400 clamp(10px, 0.72vw, 12px) / 1 "Archivo Variable", sans-serif;
        font-stretch: 125%;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .role p {
        margin: 0;
        font-size: clamp(16px, 1.3vw, 21px);
        color: var(--ink);
      }

      /* 08: faq */
      .faq {
        border-top: 1px solid var(--line);
      }
      .faq details {
        border-bottom: 1px solid var(--line);
      }
      .faq summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2vw;
        padding: 3svh 0;
        cursor: pointer;
        list-style: none;
        font-size: clamp(16px, 1.3vw, 21px);
        color: var(--ink);
      }
      .faq summary::-webkit-details-marker {
        display: none;
      }
      .plus {
        position: relative;
        flex: none;
        width: 32px;
        height: 32px;
        border: 1px solid rgb(25 22 37 / 0.35);
        border-radius: 50%;
        color: var(--ink);
        transition: border-color 0.3s, color 0.3s;
      }
      .plus::before,
      .plus::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 12px;
        height: 1.5px;
        background: currentColor;
        translate: -50% -50%;
        transition: scale 0.3s;
      }
      .plus::after {
        rotate: 90deg;
      }
      /* Open: an orange minus in an orange ring, as in the mockup. */
      .faq details[open] .plus {
        border-color: var(--orange);
        color: var(--orange);
      }
      .faq details[open] .plus::after {
        scale: 0;
      }
      .faq details p {
        margin: 0;
        max-width: 42em;
        padding: 0 0 3.4svh;
        font-size: clamp(14px, 1.05vw, 17px);
        line-height: 1.6;
        color: var(--muted);
      }
      .faq-note {
        margin: 3svh 0 0;
        font-size: clamp(13px, 0.92vw, 15px);
        color: var(--muted);
      }

      /* 09: contact */
      .contact {
        overflow: hidden;
        min-height: 100svh;
        box-sizing: border-box;
        display: grid;
        place-items: center;
        text-align: center;
        background:
          radial-gradient(55% 70% at 50% 50%, rgb(252 162 92 / 0.35), transparent 70%),
          linear-gradient(100deg, #e4dcd0 0%, #ece6dc 38%, #f6f0e6 72%, #fbf8f3 100%);
      }
      .contact-rings {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .contact-rings span:first-child {
        width: min(96svh, 96vw);
        border: 1px solid rgb(250 100 27 / 0.28);
      }
      .contact-rings span:last-child {
        width: min(80svh, 82vw);
        border: 1px solid rgb(25 22 37 / 0.16);
        background: radial-gradient(closest-side, rgb(255 255 255 / 0.3), transparent);
      }
      .contact-glow {
        position: absolute;
        left: 50%;
        bottom: -18svh;
        width: 70vw;
        height: 40svh;
        translate: -50% 0;
        background: radial-gradient(closest-side, rgb(250 110 40 / 0.5), rgb(250 110 40 / 0.15) 55%, transparent);
        filter: blur(30px);
        pointer-events: none;
      }
      .contact-body {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3.6svh;
      }
      .kicker {
        font: 400 clamp(10px, 0.8vw, 13px) / 1 "Archivo Variable", sans-serif;
        font-stretch: 125%;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--ink);
      }
      .contact-body h2 {
        font-size: clamp(26px, 3.2vw, 56px);
      }
      .contact-body .lede {
        max-width: 30em;
        margin: 0;
        color: var(--ink);
      }
      .contact-cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.6svh;
      }
      .contact-cta .cta-note {
        font: 400 clamp(13px, 0.95vw, 15px) / 1.3 "Schibsted Grotesk", sans-serif;
        letter-spacing: 0;
        text-transform: none;
      }
      /* Mail and phone side by side, split by a thin rule. */
      .reach {
        display: flex;
        justify-content: center;
      }
      .reach p {
        margin: 0;
        padding: 0 3vw;
        font-size: clamp(14px, 1vw, 16px);
        line-height: 1.7;
        color: var(--ink);
      }
      .reach p + p {
        border-left: 1px solid rgb(25 22 37 / 0.2);
      }
      .reach a {
        color: var(--ink);
        text-decoration-color: var(--orange);
        text-underline-offset: 4px;
        white-space: nowrap;
      }
      .signoff {
        margin: 3svh 0 0;
        font: 400 clamp(17px, 1.35vw, 21px) / 1.3 "Instrument Serif", Georgia, serif;
        font-variant: small-caps;
        letter-spacing: 0.14em;
        color: var(--ink);
      }
      .signoff::after {
        content: "";
        display: block;
        width: 48px;
        height: 2px;
        margin: 2.4svh auto 0;
        border-radius: 2px;
        background: var(--orange);
      }

      .foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 3svh var(--pad);
        background: var(--panel);
        border-top: 1px solid var(--line);
        font-size: 12px;
        color: rgb(25 22 37 / 0.6);
      }
      .foot nav {
        display: flex;
        gap: 2vw;
      }
      .foot a {
        color: inherit;
        text-decoration: none;
      }
      .foot a:hover {
        color: var(--ink);
      }

      /* reveal-on-scroll */
      .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition:
          opacity 0.9s ease calc(var(--d, 0) * 0.12s),
          transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--d, 0) * 0.12s);
      }
      .reveal.in {
        opacity: 1;
        transform: none;
      }

      /* ================= portrait / phone: the mockup layout ================= */
      @media (max-aspect-ratio: 1/1), (max-width: 720px) {
        :root {
          --pad: 6vw;
        }
        /* German compounds (Ansprechpartner) don't fit a phone line at full
           width; a narrower cut avoids hyphenation. */
        h1,
        h2 {
          font-size: clamp(22px, 6.2vw, 34px);
          font-stretch: 106%;
        }
        .count {
          font-size: 11px;
        }
        .lede {
          font-size: 16px;
        }
        .btn {
          min-width: 0;
          width: 100%;
          min-height: 52px;
          font-size: 13px;
        }

        /* No pinned stage: hero and cards are normal sections. */
        .track {
          height: auto;
        }
        .pin {
          position: static;
          height: auto;
          overflow: visible;
        }
        /* .pin > * / .hero > * (absolute) outrank plain class selectors. */
        .pin > .hero {
          position: relative;
        }
        .hero > .hero-bg {
          background:
            radial-gradient(70% 34% at 50% 66%, rgb(252 162 92 / 0.4), transparent 70%),
            linear-gradient(180deg, #f6f0e6 0%, #f3ebe0 60%, #f6f0e6 100%);
        }
        .hero > .hero-text {
          position: relative;
          inset: auto;
          display: flex;
          flex-direction: column;
          padding: calc(48px + 8svh) var(--pad) 4svh;
          pointer-events: auto;
        }
        .hero-count {
          display: block;
          margin-bottom: 3svh;
        }
        .hero > .count-fixed {
          display: none;
        }
        .eyebrow {
          margin-bottom: 2.2svh;
          font-size: 12px;
        }
        .hero-main h1 {
          font-size: clamp(22px, 6.2vw, 34px);
        }
        .hero-side {
          gap: 2svh;
          margin-top: 2.6svh;
        }
        .hero-lede {
          margin: 0 0 1svh;
          font-size: 16px;
        }
        .hero-side .btn {
          width: auto;
          min-height: 52px;
          padding: 14px 34px;
          font-size: 13px;
          letter-spacing: 0.06em;
        }
        .cta-note,
        .hero-side .cta-note {
          margin-left: 0;
          font-size: 11px;
        }
        .hero-text > .orb-stage {
          position: relative;
          inset: auto;
          z-index: 0;
          margin: 3svh calc(-1 * var(--pad)) 0;
          aspect-ratio: 1 / 0.82;
        }
        .bokeh i:nth-child(1) { left: 2%; top: 22%; width: 64px; }
        .bokeh i:nth-child(2) { left: 80%; top: 0%; width: 72px; opacity: 0.8; }
        .bokeh i:nth-child(3) { left: 80%; top: 70%; width: 66px; }
        .bokeh i:nth-child(4) { display: none; }
        .highlights {
          display: block;
          margin: 3svh 0 0;
          padding: 0;
          border-top: 1px solid var(--line);
        }
        .highlights li {
          justify-content: flex-start;
          padding: 2.2svh 0;
          border-bottom: 1px solid var(--line);
          font-size: 13px;
        }
        .highlights li + li {
          border-left: 0;
        }

        .pin > .services {
          position: relative;
          inset: auto;
          justify-content: flex-start;
          background: var(--panel);
          transform: none;
          padding: 12svh var(--pad) 10svh;
          gap: 4svh;
          border-top: 1px solid var(--line);
        }
        .services-count {
          display: block;
          position: absolute;
          left: var(--pad);
          top: 5svh;
        }
        .services-head {
          grid-template-columns: 1fr;
          row-gap: 2.4svh;
        }
        .services-head h2 {
          font-size: clamp(22px, 6.2vw, 34px);
        }
        .services-head p {
          max-width: none;
          padding: 0;
          border-left: 0;
          font-size: 17px;
        }
        .cards {
          flex: none;
          grid-template-columns: 1fr;
          grid-template-rows: none;
          gap: 14px;
        }
        /* Phones: icon left, copy right (mobile mockup). */
        .card {
          grid-row: auto;
          grid-template-columns: 36% 1fr;
          grid-template-rows: none;
          align-items: center;
          column-gap: 10px;
          padding: 26px 18px 26px 10px;
        }
        .card-icon {
          justify-self: stretch;
        }
        .card-copy {
          display: block;
        }
        .card-icon :global(.ic),
        .tile-icon :global(.ic) {
          width: 72px;
        }
        .card h3 {
          margin-bottom: 8px;
          font-size: 18px;
        }
        .card p {
          font-size: 15px;
        }
        .tagline {
          padding: 3svh 0;
          font-size: 20px;
        }
        .tagline span {
          display: block;
        }

        .sec {
          padding: 12svh var(--pad) 10svh;
        }
        .sec > .count {
          top: 5svh;
        }
        .split,
        .sec-head,
        .energy,
        .dark-head {
          grid-template-columns: 1fr;
          row-gap: 2.4svh;
        }
        .split-head .lede {
          margin-top: 2.4svh;
        }
        .split {
          row-gap: 5svh;
        }

        .energy {
          margin-top: 4svh;
        }
        .portal {
          padding: 20px 16px;
        }
        .portal-tiles {
          display: grid;
          gap: 10px;
        }
        .portal-board {
          display: none;
        }
        .portal-tiles li {
          gap: 8px;
          padding: 14px 10px;
          font-size: 13px;
        }
        .rows {
          margin-top: 5svh;
          border-top: 0;
        }
        .row {
          grid-template-columns: 52px 1fr;
          gap: 8px;
          padding: 3svh 0;
        }
        .big-num {
          font-size: 24px;
        }
        .row h3 {
          font-size: 20px;
        }
        .row p,
        .tile p,
        .step p {
          font-size: 15px;
        }
        .tasks li {
          font-size: 15px;
        }

        .tiles {
          grid-template-columns: 1fr;
          gap: 14px;
          margin-top: 5svh;
        }
        .tile {
          grid-template-columns: 34% 1fr;
          grid-template-areas: "num copy" "icon copy";
          align-items: center;
          column-gap: 12px;
          row-gap: 8px;
          padding: 22px 18px 24px;
        }
        .tile .row-num {
          align-self: end;
        }
        .tile-icon {
          align-self: start;
          justify-self: center;
        }
        .tile h3 {
          margin-bottom: 8px;
          font-size: 18px;
        }
        .claim {
          margin: 6svh calc(-1 * var(--pad)) 0;
          padding: 28px var(--pad) 28px calc(var(--pad) + 22px);
          border-radius: 0;
        }
        .claim::before {
          left: var(--pad);
          top: 28px;
          bottom: 28px;
        }
        .claim-title {
          font-size: clamp(20px, 5.6vw, 28px);
          font-stretch: 106%;
        }
        .claim p {
          font-size: 15px;
        }

        .dark-head .lede {
          margin-top: 0;
        }
        .choices {
          grid-template-columns: 1fr;
          margin-top: 5svh;
        }
        .choices li {
          padding: 3.4svh 0;
          border-bottom: 1px solid rgb(255 255 255 / 0.16);
        }
        .choices li > :not(.choice-num) {
          margin-left: 22px;
        }
        .choice-num {
          margin-bottom: 1.6svh;
          font-size: 40px;
        }
        .choices h3 {
          font-size: 20px;
        }
        .choices p {
          font-size: 16px;
        }
        .glow-text {
          margin-top: 0;
          border-top: 0;
          font-size: 19px;
        }

        .team-grid {
          grid-template-columns: 1fr;
          grid-template-rows: none;
        }
        .team-grid > h2,
        .team-photo,
        .team-copy {
          grid-column: auto;
          grid-row: auto;
        }
        .team-copy .lede {
          margin-bottom: 3svh;
        }
        .person summary {
          padding: 18px 20px;
        }
        .person-name {
          font-size: 19px;
        }
        .person-role {
          font-size: 15px;
        }
        .person ul {
          padding: 0 20px 18px 38px;
        }
        .trust {
          flex-direction: column;
          align-items: stretch;
          margin-top: 8svh;
          padding: 24px 20px;
        }

        /* Steps become a vertical timeline: navy dots on an orange line. */
        .steps {
          grid-template-columns: 1fr;
          gap: 0;
          margin-top: 5svh;
        }
        .step {
          padding: 0 0 4.4svh 44px;
        }
        .step::before {
          left: 6px;
          right: auto;
          top: 14px;
          bottom: -14px;
          width: 2px;
          height: auto;
          background: var(--orange);
        }
        .step:last-child::before,
        .step::after {
          display: none;
        }
        .step-dot {
          left: 0;
          top: 14px;
          width: 14px;
          height: 14px;
        }
        .step .big-num {
          margin-bottom: 1.4svh;
        }
        .step h3 {
          font-size: 20px;
        }
        .roles {
          grid-template-columns: 1fr;
          gap: 0;
          margin-top: 2svh;
          padding-top: 0;
        }
        .role {
          padding: 2.4svh 0;
          border-bottom: 1px solid var(--line);
        }
        .role p {
          font-size: 18px;
        }
        .roles .btn {
          margin-top: 3svh;
        }

        .faq summary {
          font-size: 18px;
        }

        .contact {
          padding-top: 16svh;
        }
        .contact-rings span:first-child { width: 150vw; }
        .contact-rings span:last-child { width: 122vw; }
        .contact-body h2 {
          font-size: clamp(26px, 8vw, 40px);
        }
        .contact-cta {
          align-self: stretch;
        }
        .kicker {
          font-size: 12px;
          letter-spacing: 0.26em;
        }
        .reach {
          flex-direction: column;
          gap: 2.4svh;
        }
        .reach p {
          padding: 0;
        }
        .reach p + p {
          border-left: 0;
        }

        .foot {
          flex-direction: column;
          gap: 10px;
        }
        .foot nav {
          gap: 20px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .step::after {
          width: 100%;
          transition: none;
        }
      }
    </style>
  </body>
</html>
