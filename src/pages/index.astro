      }
      .epilog__note {
        margin: 0 0 0.5rem !important;
        font-size: 0.78rem;
        opacity: 0.8;
      }
    </style>

    <script is:inline>
      // Erst auf Klick starten und dann die nativen Controls freigeben, damit die
      // dunkle Leiste nicht dauerhaft auf der Cremefläche liegt.
      (function () {
        var btn = document.querySelector("[data-play-video]");
        var vid = document.getElementById("epilog-video");
        if (!btn || !vid) return;
        // JS ist da: native Controls weg, eigener Button her.
        vid.controls = false;
        btn.hidden = false;
        btn.addEventListener("click", function () {
          vid.closest(".epilog__vwrap").classList.add("is-playing");
          vid.controls = true;
          vid.play();
          btn.hidden = true;
        });
      })();
    </script>

    <!-- ?v= bei JEDER Engine-Änderung mitziehen. GitHub Pages liefert nur
         max-age=600, aber ein Telefon, das die alte Engine im HTTP-Cache hat,
         darf sie bis zu 10 Minuten ungefragt weiterverwenden — und genau in so
         einem Fenster wirkt ein frisch deployter Fix wie "hat nichts gebracht".
         Neue URL = garantiert neue Datei, sobald das HTML frisch ist. -->
    <script is:inline src="/scrollworld/scrub-engine.js?v=12"></script>
    <script
      is:inline
      set:html={`window.SW = mountScrollWorld(document.getElementById('world'), ${JSON.stringify(config)});`}
    />

    <script is:inline>
      // Hero-CTA einhängen. Die Engine baut ihr DOM erst beim Mounten, deshalb
      // steht der Button als statisches Markup im Body und zieht erst hier an
      // seinen Platz:
      //   Desktop → direkt in die .sw-copylayer (position:fixed; inset:0), also
      //             absolut unten rechts im Viewport. Die Copylayer ist
      //             pointer-events:none, Opacity und Klickbarkeit werden unten
      //             mit dem Copy-Fade von Szene 01 synchronisiert.
      //   Mobil   → in den Copy-Block von Szene 01. Dort erbt er Opacity,
      //             translateY und pointer-events der Engine — kein Sync nötig,
      //             und ein eigenes opacity würde sich mit dem geerbten
      //             multiplizieren (0.5 * 0.5 = 0.25).
      (function () {
        var cta = document.querySelector(".hero-cta");
        var layer = document.querySelector(".sw-copylayer");
        var first = document.querySelector(".sw-copy");
        if (!cta || !layer || !first) return;

        // Bewusst NUR die Breite — nicht isMobile() der Engine, das zusätzlich
        // auf (pointer: coarse) prüft. Deren Kriterium entscheidet über die
        // Video-Encodes (Bandbreite), hier geht es allein um den Platz unten
        // rechts. 860px ist exakt die Schwelle, ab der die Engine ihren
        // Copy-Block auf volle Breite an den unteren Rand legt — genau der
        // Moment, in dem die Ecke belegt ist. Muss zur @media-Regel im
        // Stylesheet passen.
        var small = window.matchMedia("(max-width: 860px)");
        var obs = null;

        function sync() {
          var o = first.style.opacity === "" ? 1 : parseFloat(first.style.opacity);
          cta.style.opacity = o;
          // Gleiche Schwelle wie die Engine für ihre Copy-Blöcke: unsichtbar =
          // nicht klickbar, sonst schluckt der CTA ab Szene 02 unsichtbar Klicks.
          cta.style.pointerEvents = o > 0.5 ? "auto" : "none";
        }

        function place() {
          if (small.matches) {
            if (cta.parentNode !== first) first.appendChild(cta);
            if (obs) { obs.disconnect(); obs = null; }
            cta.style.opacity = "";
            cta.style.pointerEvents = "";
          } else {
            if (cta.parentNode !== layer) layer.appendChild(cta);
            // Die Engine schreibt die Copy-Opacity als Inline-Style in ihrer
            // rAF-Schleife. Ein MutationObserver läuft als Microtask direkt
            // danach — also im selben Frame, ohne eigene Schleife und ohne den
            // Fade-Verlauf (smooth(1 - pr/0.62)) hier zu duplizieren.
            if (!obs) {
              obs = new MutationObserver(sync);
              obs.observe(first, { attributes: true, attributeFilter: ["style"] });
            }
            sync();
          }
          cta.hidden = false;
        }

        place();
        small.addEventListener("change", place);
      })();
    </script>

    <script is:inline>
      // Der Epilog gehört in die Topbar-Navigation, aber NICHT in die Route-Rail
      // rechts: deren Punkte markieren die Szenen des Kameraflugs ("05 / 05"),
      // ein sechster Punkt würde ein sechstes Diorama versprechen, das es nicht
      // gibt, und den Zähler verstimmen. Deshalb wird hier nur die Nav ergänzt.
      (function () {
        var nav = document.querySelector(".sw-nav");
        var target = document.getElementById("epilog");
        if (!nav || !target) return;

        // Ziel absolut messen statt offsetTop: der Epilog liegt im normalen Fluss
        // hinter dem Track-Spacer, sein offsetParent ist nicht garantiert der Body.
        function epilogY() {
          return Math.round(target.getBoundingClientRect().top + (window.scrollY || 0));
        }

        // Mit aktivem Snap denselben animierten Flug nehmen wie die Szenen-Navigation
        // — sonst teleportiert ein Nav-Klick über den kompletten Kameraflug hinweg.
        function goEpilog() {
          if (window.SW && window.SW.scrollTo) window.SW.scrollTo(epilogY());
          else window.scrollTo(0, epilogY());
        }

        var b = document.createElement("button");
        b.type = "button";
        b.className = "sw-nav__item sw-nav__item--epilog";
        b.textContent = "Die Menschen";
        b.addEventListener("click", goEpilog);
        nav.appendChild(b);

        // Gleiches Ziel, gleicher Weg: der Sekundär-Button der Schlussszene
        // ("Die Menschen dahinter ↓") ist ein reiner #epilog-Anker.
        document.querySelectorAll('a[href="#epilog"]').forEach(function (a) {
          a.addEventListener("click", function (e) {
            e.preventDefault();
            goEpilog();
          });
        });

        // Die Engine rendert ihre Buttons ohne target. Externe Ziele (Calendly)
        // sollen einen neuen Tab öffnen — sonst landet der Zurück-Button auf der
        // frisch geladenen Startseite bei Scroll 0 und der ganze Flug ist weg.
        document.querySelectorAll('.sw-btn[href^="http"], .sw-topcta[href^="http"]').forEach(function (a) {
          a.target = "_blank";
          a.rel = "noopener";
        });

        // Active-State. Die Engine aktualisiert Nav und Route-Rail nur, wenn sich
        // die Sektion ändert (`if (near !== activeIndex)`); beim Scrollen in den
        // Epilog bleibt `near` auf der letzten Szene stehen. Sie überschreibt uns
        // also nicht laufend — es genügt, die beiden Übergänge zu behandeln:
        // rein  → eigenen Eintrag aktiv, Szenen-Einträge aus.
        // raus  → Engine-Zustand aus der Route-Rail spiegeln, die weiterhin
        //         korrekt gepflegt wird (identische Reihenfolge wie die Nav).
        var scenes = nav.querySelectorAll(".sw-nav__item:not(.sw-nav__item--epilog)");
        var dots = document.querySelectorAll(".sw-route__dot");

        function setActive(inEpilog) {
          b.classList.toggle("is-active", inEpilog);
          for (var i = 0; i < scenes.length; i++) {
            scenes[i].classList.toggle(
              "is-active",
              !inEpilog && dots[i] && dots[i].classList.contains("is-active")
            );
          }
        }

        if ("IntersectionObserver" in window) {
          new IntersectionObserver(
            function (entries) {
              setActive(entries[0].isIntersecting);
            },
            // Schmales Band in der Viewport-Mitte: der Eintrag wird aktiv, sobald
            // der Epilog die Mitte überquert — nicht schon beim Hereinschieben.
            { rootMargin: "-45% 0px -45% 0px" }
          ).observe(target);
        }
      })();
    </script>
  </body>
</html>
