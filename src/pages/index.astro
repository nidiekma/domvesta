---
// ============================================================================
// Domvesta — Startseite (Scroll-World)
// ----------------------------------------------------------------------------
// Scroll-gescrubbter Kameraflug durch eine Papercraft-Dioramenwelt. Die Kamera
// taucht in jede Szene hinein und fliegt über einen Connector-Clip nahtlos in
// die nächste — keine Schnitte. Danach der Epilog mit den echten Gründern.
//
// ACHTUNG — bewusste Entscheidung des Kunden (Juli 2026): diese Seite hat den
// bisherigen One-Pager vollständig ersetzt. Damit sind Leistungstexte,
// 5-Schritte-Ablauf, Kontaktformular und die Experten-Stichpunkte NICHT mehr
// auf der Seite; die zugehörigen Exporte in site.ts (about, services, process,
// ticker, interessensbereiche) werden aktuell nirgends gerendert. Der alte
// One-Pager liegt in der Git-Historie (bis Commit 4758143,
// src/layouts/DomvestaSite.astro) und lässt sich jederzeit zurückholen.
// Conversion läuft jetzt über Calendly und E-Mail.
//
// Texte stammen 1:1 aus src/data/site.ts (kundenfreigegebene Formulierungen),
// nicht neu erfunden. Assets: public/scrollworld/.
// Engine: public/scrollworld/scrub-engine.js (vanilla, framework-agnostisch).
// ============================================================================
import "../styles/global.css";
import { site, founders, video } from "../data/site.ts";

const year = 2026;

const V = "/scrollworld/vid";

const config = {
  brand: { name: site.name, href: "/" },
  // Dauerhafter Buchungsweg in der Topbar. Ohne ihn erreicht ein Besucher, der
  // sofort buchen will, den ersten Calendly-Link erst nach ~7 Viewport-Höhen.
  // Der alte One-Pager hatte diesen CTA von der ersten Sekunde an.
  cta: { label: "Termin buchen", href: site.calendlyUrl },
  diveScroll: 1.3,
  connScroll: 0.9,
  // Die Connector-Clips wurden auf den Frame bei -0,15 s des jeweiligen Dives
  // konditioniert — bei 24 fps fehlen an der Naht also ~3 Frames Kamerabewegung.
  // Etwas breiterer Crossfade als der Default (0.12) blendet genau das weg.
  crossfade: 0.18,
  hint: "Scrollen für die Tour",
  nav: true,
  atmosphere: true,
  sections: [
    {
      id: "liegenschaften",
      label: "Ihr Bestand",
      still: "/scrollworld/liegenschaften.webp",
      clip: `${V}/liegenschaften.mp4`,
      accent: "#e8651b",
      eyebrow: "Für Hausverwaltungen",
      title: "Alter Verwalter, ist das einfach!",
      body: "Keine zehn Ansprechpartner mehr für Energie & Versicherung. Nur noch einer — persönlich, digital und zuverlässig.",
      tags: ["Strom & Gas", "Versicherungen"],
    },
    {
      id: "papierkram",
      label: "Der Aufwand",
      still: "/scrollworld/papierkram.webp",
      clip: `${V}/papierkram.mp4`,
      accent: "#6b5742",
      eyebrow: "Das Problem",
      title: "Zehn Ansprechpartner. Eine Aufgabe.",
      body: "Unterschiedliche Energieversorger, unübersichtliche Verträge und fehlerhafte Abrechnungen kosten Hausverwaltungen täglich Zeit und Nerven.",
      tags: ["Verträge", "Abrechnungen", "Zeitfresser"],
    },
    {
      id: "energie",
      label: "Strom & Gas",
      still: "/scrollworld/energie.webp",
      clip: `${V}/energie.mp4`,
      accent: "#e8651b",
      scroll: 1.6,
      linger: 0.42,
      eyebrow: "Strom & Gas",
      title: "Verwalten war gestern.",
      body: "Unser digitales Lieferstellenportal bündelt sämtliche Strom- und Gasverträge Ihrer Liegenschaften.",
      tags: ["Preisprüfung", "Rahmenverträge", "Lieferstellenportal"],
    },
    {
      id: "versicherung",
      label: "Versicherungen",
      still: "/scrollworld/versicherung.webp",
      clip: `${V}/versicherung.mp4`,
      accent: "#1f4e8c",
      scroll: 1.6,
      linger: 0.42,
      eyebrow: "Versicherungen",
      title: "Papierkram war gestern.",
      body: "Wir übernehmen die Betreuung Ihrer Wohngebäude- und Grundbesitzerhaftpflicht — inklusive Schadensmanagement.",
      tags: ["Rahmenverträge", "Vertragsmanagement", "Schadensmanagement"],
    },
    {
      id: "gespraech",
      label: "Erstgespräch",
      still: "/scrollworld/gespraech.webp",
      clip: `${V}/gespraech.mp4`,
      accent: "#e8651b",
      scroll: 1.8,
      linger: 0.5,
      eyebrow: "Ein Ansprechpartner",
      title: "Mehr Zeit für Hausverwaltungen.",
      body: "Energie & Versicherung aus einer Hand. Lernen wir uns in einem unverbindlichen Gespräch kennen.",
      // Die Bewertung MUSS Ben Siefkes zugeordnet werden, wo immer sie genannt
      // wird (§ 5 / § 5b Abs. 3 UWG) — das Profil gehört ihm persönlich, nicht
      // Domvesta. Siehe Kommentar an site.rating. Wortlaut wie im Laufband.
      tags: [
        `${site.rating.score} / ${site.rating.max} für ${site.rating.subject} auf ${site.rating.platform}`,
      ],
      cta: {
        primary: { label: "Erstgespräch buchen", href: site.calendlyUrl },
        // Zeigt bewusst nach unten statt nach außen: die Schlussszene wirkt mit
        // zwei Buttons wie das Seitenende, sonst sehen viele Teamfoto und Video
        // nie. Der Weg zur Hauptseite steht im Epilog.
        secondary: { label: "Die Menschen dahinter ↓", href: "#epilog" },
      },
    },
  ],
  connectors: [
    `${V}/conn1.mp4`,
    `${V}/conn2.mp4`,
    `${V}/conn3.mp4`,
    `${V}/conn4.mp4`,
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: die Engine nutzt env(safe-area-inset-*) für Notch/Home-Indicator -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{site.name} — Energie & Versicherung für Hausverwaltungen</title>
    <meta
      name="description"
      content={`${site.name}: Betreuung rund um Strom & Gas und Versicherungen für Hausverwaltungen. Persönlich, digital und langfristig.`}
    />
  </head>
  <body>
    <!-- Die Engine rendert alle Überschriften als h2 und baut ihr DOM erst per JS.
         Ohne diesen h1 hätte die Startseite gar keine Hauptüberschrift. -->
    <h1 class="sr-only">{site.name} — {site.claim} {site.claimAccent}</h1>

    <div id="world"></div>

    <!-- Ohne JavaScript (oder wenn scrub-engine.js nicht lädt) bleibt #world leer.
         Deshalb hier dieselben Inhalte als statische Fassung — auch für Crawler,
         die kein JS ausführen. -->
    <noscript>
      <div class="nojs">
        {config.sections.map((s) => (
          <section class="nojs__scene">
            <img src={s.still} alt="" width="1536" height="1024" loading="lazy" decoding="async" />
            <p class="nojs__eyebrow">{s.eyebrow}</p>
            <h2 class="nojs__title">{s.title}</h2>
            <p class="nojs__body">{s.body}</p>
          </section>
        ))}
        <p class="nojs__cta">
          <a href={site.calendlyUrl} target="_blank" rel="noopener">Erstgespräch buchen</a>
        </p>
      </div>
    </noscript>

    <!-- ======================= EPILOG: die echten Menschen =======================
      Der Flug endet an einem leeren Papiertisch mit zwei Stühlen gegenüber. Hier
      wird aufgelöst, wer dort sitzt — Teamfoto und Video als Landung in der
      Realität. Damit erfüllt auch /welt das PRODUCT.md-Prinzip 2 (Vertrauen
      entsteht durch echte Menschen), das die reine KI-Bildwelt sonst unterläuft.

      Technisch: die Engine arbeitet komplett mit position:fixed (Sky z0, Stage z10,
      Copy z20, Route z40, Topbar z50) über einem hohen Track-Spacer. Der Epilog
      liegt danach im normalen Fluss und braucht nur z-index:45 + deckenden
      Hintergrund — über der Stage, aber unter der Topbar, damit die Nav bleibt.

      Hintergrund ist exakt --cream-deep #f6e8d3: das Video wurde ohne Alpha auf
      genau diesen Ton gerendert (siehe site.ts) und steht damit rahmenlos im
      Raum — so wie die Papier-Objekte in der Schlussszene um den Tisch schweben.
    -->
    <section class="epilog" id="epilog" aria-labelledby="epilog-title">
      <div class="epilog__inner">
        <p class="epilog__eyebrow">Und dahinter</p>
        <h2 class="epilog__title" id="epilog-title">
          Zwei Menschen. <em>Kein Callcenter.</em>
        </h2>
        <p class="epilog__lead">
          Die beiden Stühle am Tisch sind nicht dekorativ. Hier sind die zwei, die
          darauf sitzen.
        </p>

        <figure class="epilog__team">
          <img
            src="/team.webp"
            srcset="/team-800.webp 800w, /team.webp 1600w"
            sizes="(max-width: 900px) 92vw, 1080px"
            width="1600"
            height="1196"
            alt={`${founders[0].name} und ${founders[1].name} von ${site.name}`}
            loading="lazy"
            decoding="async"
          />
        </figure>

        <ul class="epilog__people">
          {founders.map((f) => (
            <li class="person">
              <span class="person__initials" aria-hidden="true">{f.initials}</span>
              <span class="person__text">
                <strong>{f.name}</strong>
                <span>{f.role}</span>
              </span>
            </li>
          ))}
        </ul>

        <!-- Video rahmenlos: gleicher Hintergrundton wie die Datei selbst.
             Bewusst OHNE native controls im Ruhezustand — die dunkle Controls-
             Leiste ist ein massiver Balken auf der Cremefläche und zerstört den
             schwebenden Eindruck. Erst beim Start werden die echten Controls
             eingeblendet (Scrubben/Ton bleiben also verfügbar). -->
        <div class="epilog__video">
          <h3 class="epilog__vtitle">{video.title}</h3>
          <p class="epilog__vlead">{video.lead}</p>
          <!-- Progressive Enhancement: `controls` steht im Markup, damit das Video
               auch ohne JS abspielbar bleibt. Erst wenn JS läuft, werden die
               Controls entfernt (dunkler Balken auf der Cremefläche) und
               stattdessen der eigene Play-Button eingeblendet. -->
          <div class="epilog__vwrap">
            <video
              id="epilog-video"
              controls
              playsinline
              preload="none"
              poster={video.poster}
              src={video.src}></video>
            <button class="epilog__play" type="button" data-play-video hidden>
              <span class="epilog__play-icon" aria-hidden="true"></span>
              Video abspielen
            </button>
          </div>
        </div>

        <div class="epilog__cta">
          <a
            class="epilog__btn epilog__btn--primary"
            href={site.calendlyUrl}
            target="_blank"
            rel="noopener"
          >
            Erstgespräch buchen
          </a>
          <!-- Mit dem Wegfall des Kontaktformulars ist E-Mail der einzige
               verbliebene Kanal neben Calendly. -->
          <a class="epilog__btn" href={`mailto:${site.email}`}>E-Mail schreiben</a>
        </div>

        <!-- Impressum und Datenschutz sind bei einem gewerblichen deutschen
             Auftritt Pflicht und müssen von jeder Seite aus erreichbar sein.
             Der alte One-Pager hatte sie im Footer — hier ist der Seitenschluss. -->
        <footer class="epilog__legal">
          <nav>
            {/* Zuordnung auch hier, siehe § 5 / § 5b Abs. 3 UWG. */}
            <a href={site.provenExpertUrl} target="_blank" rel="noopener">
              ProvenExpert ({site.rating.subject})
            </a>
            <a href="/impressum">Impressum</a>
            <a href="/datenschutz">Datenschutz</a>
          </nav>
          <p class="epilog__note">
            {site.rating.score} / {site.rating.max} aus {site.rating.count} Bewertungen für{" "}
            {site.rating.subject}, {site.rating.disclaimer}.
          </p>
          <p>© {year} {site.name}. Mit ❤ für Hausverwaltungen.</p>
        </footer>
      </div>
    </section>

    <style is:global>
      /* Theme-Tokens der Engine auf die Domvesta-Palette (DESIGN.md) mappen.
         Unlayered :root gewinnt gegen @layer sw der Engine — keine !important nötig. */
      :root {
        --sw-bg: #fbf2e4;
        --sw-ink: #2a1c10;
        --sw-ink-soft: #6b5742;
        --sw-accent: #e8651b;
        --sw-font-display: "Instrument Serif", Georgia, serif;
        --sw-font-body: "Schibsted Grotesk", system-ui, sans-serif;
      }
      html,
      body {
        margin: 0;
        background: var(--sw-bg);
      }
      /* Die Engine scrubbt currentTime aus der Scroll-Position — natives Smooth-
         Scrolling (global.css) würde dabei nachlaufen. */
      html {
        scroll-behavior: auto;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
      }

      /* FIX: Die Engine setzt pointer-events der ausgeblendeten Copy auf none,
         .sw-copy__cta trägt aber ein explizites pointer-events:auto — und ein
         Nachfahre mit auto bleibt laut Spec anklickbar, auch wenn ein Vorfahre
         none ist. Dadurch war der unsichtbare Calendly-Button der Schlussszene
         ab Scroll 0 unten links im Viewport klickbar. `inherit` übernimmt den
         Wert, den die Engine auf .sw-copy schreibt. Unlayered schlägt @layer sw. */
      .sw-copy__cta {
        pointer-events: inherit;
      }

      /* Der Hinweis "Scrollen für die Tour" wird nur auf opacity 0 geblendet,
         behält aber seine Fläche samt pointer-events und würde dort Taps
         schlucken. Er ist rein dekorativ. */
      .sw-hint {
        pointer-events: none;
      }

      /* Statische Fassung ohne JS */
      .nojs {
        max-width: 820px;
        margin: 0 auto;
        padding: clamp(2rem, 6vw, 4rem) clamp(1.2rem, 5vw, 3rem);
        font-family: var(--sw-font-body);
        color: var(--sw-ink);
      }
      .nojs__scene {
        margin-bottom: clamp(2.5rem, 6vw, 4rem);
      }
      .nojs__scene img {
        width: 100%;
        height: auto;
        border-radius: 22px;
      }
      .nojs__eyebrow {
        margin: 1.2rem 0 0.4rem;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--sw-accent);
      }
      .nojs__title {
        margin: 0 0 0.6rem;
        font-family: var(--sw-font-display);
        font-weight: 400;
        font-size: clamp(1.9rem, 4.5vw, 2.8rem);
        line-height: 1.05;
      }
      .nojs__body {
        margin: 0;
        color: var(--sw-ink-soft);
        line-height: 1.6;
      }
      .nojs__cta a {
        display: inline-block;
        padding: 0.95rem 1.7rem;
        border-radius: 999px;
        background: var(--sw-accent);
        color: #fff;
        font-weight: 600;
        text-decoration: none;
      }

      /* Die Engine zeichnet als Markenzeichen nur einen generischen Platzhalter
         (leeres <span> mit Verlauf) und kennt keine brand.logo-Option. Hier das
         echte Logo als Hintergrund — rein per CSS, damit beim Laden nicht kurz
         das Quadrat aufblitzt. Kein alt nötig: der Markenname steht als Text
         direkt daneben, das Zeichen ist dekorativ.
         logo.png ist 152x159 (rgba) — `contain` hält das Seitenverhältnis. */
      .sw-brand__mark {
        /* 34px statt der 24x28 des Platzhalters: das Zeichen ist fein
           gegliedert und wird darunter matschig. Die Hauptseite nutzt 38px,
           die kompaktere Topbar hier verträgt etwas weniger. */
        width: 34px;
        height: 34px;
        flex: none;
        border-radius: 0;
        background: url("/logo.png") center / contain no-repeat;
        box-shadow: none;
      }

      /* Nav-Eintrag zum Epilog: durch die Trennlinie als Sprungziel lesbar und
         nicht als sechste Szene des Flugs. */
      .sw-nav__item--epilog {
        border-left: 1px solid color-mix(in srgb, var(--sw-ink) 18%, transparent);
        margin-left: 4px;
      }

      /* ===================== EPILOG ===================== */
      .epilog {
        position: relative;
        /* über Stage (10) / Copy (20) / Route (40), unter Topbar (50) */
        z-index: 45;
        /* Exakt der Ton, auf den das Video gerendert wurde → rahmenlos. */
        background: #f6e8d3;
        color: var(--sw-ink);
        font-family: var(--sw-font-body);
        padding: clamp(4.5rem, 11vh, 8rem) clamp(1.2rem, 5vw, 3rem)
          calc(clamp(4rem, 9vh, 7rem) + env(safe-area-inset-bottom, 0px));
        /* Weiche Kante nach oben: die Papierwelt "legt sich" über den Flug. */
        box-shadow: 0 -40px 60px -30px rgb(42 28 16 / 0.18);
      }
      .epilog__inner {
        max-width: 1080px;
        margin: 0 auto;
        text-align: center;
      }
      .epilog__eyebrow {
        margin: 0 0 0.9rem;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--sw-accent);
      }
      .epilog__title {
        margin: 0 0 1rem;
        font-family: var(--sw-font-display);
        font-weight: 400;
        line-height: 1.02;
        letter-spacing: -0.01em;
        font-size: clamp(2.2rem, 5.5vw, 4rem);
      }
      .epilog__title em {
        font-style: italic;
        color: var(--sw-accent);
      }
      .epilog__lead {
        margin: 0 auto clamp(2.5rem, 6vh, 4rem);
        max-width: 46ch;
        font-size: 1.0625rem;
        line-height: 1.6;
        color: var(--sw-ink-soft);
      }

      /* team.webp ist freigestellt (yuva420p) — also KEINE Fotokarte, sondern die
         beiden stehen direkt auf der Papierfläche. drop-shadow folgt dem Alpha-
         Umriss statt einem Rechteck und gibt ihnen denselben weichen Kontakt-
         schatten, den laut Style-Preamble jedes Diorama im Flug hat. */
      .epilog__team {
        margin: 0 0 clamp(1.6rem, 4vh, 2.4rem);
      }
      .epilog__team img {
        display: block;
        width: min(560px, 82vw);
        height: auto;
        margin: 0 auto;
        /* Die Vorlage ist ein Halbkörper-Freisteller und endet unten hart. Ohne
           Verlauf zeichnet der Schatten diese gerade Kante nach und die beiden
           wirken abgeschnitten — der Fade lässt sie ins Papier auslaufen. */
        -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 97%);
        mask-image: linear-gradient(to bottom, #000 72%, transparent 97%);
        filter: drop-shadow(0 14px 18px rgb(42 28 16 / 0.16));
      }

      .epilog__people {
        list-style: none;
        margin: 0 0 clamp(3.5rem, 9vh, 6rem);
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.8rem 1.2rem;
      }
      .person {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.55rem 1.1rem 0.55rem 0.55rem;
        border: 1px solid #e6d6bf;
        border-radius: 999px;
        background: #fbf2e4;
        text-align: left;
      }
      .person__initials {
        display: grid;
        place-items: center;
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 999px;
        background: var(--sw-accent);
        color: #fff;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
      }
      .person__text {
        display: flex;
        flex-direction: column;
        line-height: 1.25;
      }
      .person__text strong {
        font-size: 0.95rem;
        font-weight: 600;
      }
      .person__text span {
        font-size: 0.82rem;
        color: var(--sw-ink-soft);
      }

      /* Video: 9:16, ohne Rahmen — der Dateihintergrund IST der Seitenhintergrund. */
      .epilog__vtitle {
        margin: 0 0 0.6rem;
        font-family: var(--sw-font-display);
        font-weight: 400;
        font-size: clamp(1.7rem, 3.6vw, 2.4rem);
        line-height: 1.1;
      }
      .epilog__vlead {
        margin: 0 auto 1.8rem;
        max-width: 44ch;
        font-size: 1rem;
        line-height: 1.6;
        color: var(--sw-ink-soft);
      }
      .epilog__vwrap {
        position: relative;
        width: min(340px, 78vw);
        margin: 0 auto;
      }
      .epilog__video video {
        display: block;
        width: 100%;
        aspect-ratio: 9 / 16; /* Quelle ist 1080x1920 */
        background: #f6e8d3;
        object-fit: cover;
        border-radius: 22px;
      }
      /* Im Ruhezustand unten auslaufen lassen — sonst steht der Schreibtisch als
         hartes Rechteck auf der Cremefläche, während das Teamfoto weich ausläuft.
         Beim Abspielen entfernt, damit die Controls nicht mitgefadet werden. */
      .epilog__vwrap:not(.is-playing) video {
        -webkit-mask-image: linear-gradient(to bottom, #000 82%, transparent 99%);
        mask-image: linear-gradient(to bottom, #000 82%, transparent 99%);
      }
      .epilog__play {
        position: absolute;
        left: 50%;
        bottom: 6%;
        transform: translateX(-50%);
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.8rem 1.4rem;
        border: 0;
        border-radius: 999px;
        background: var(--sw-accent);
        color: #fff;
        font-family: var(--sw-font-body);
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 10px 22px -10px rgb(42 28 16 / 0.55);
        transition: transform 0.18s ease;
      }
      .epilog__play:hover {
        transform: translateX(-50%) translateY(-2px);
      }
      .epilog__play:focus-visible {
        outline: 3px solid var(--sw-ink);
        outline-offset: 3px;
      }
      .epilog__play[hidden] {
        display: none;
      }
      .epilog__play-icon {
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 6px 0 6px 10px;
        border-color: transparent transparent transparent #fff;
      }
      @media (prefers-reduced-motion: reduce) {
        .epilog__play {
          transition: none;
        }
        .epilog__play:hover {
          transform: translateX(-50%);
        }
      }

      .epilog__cta {
        margin-top: clamp(3rem, 8vh, 5rem);
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.8rem;
      }
      .epilog__btn {
        display: inline-block;
        padding: 0.95rem 1.7rem;
        border: 1px solid #e6d6bf;
        border-radius: 999px;
        font-size: 0.98rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--sw-ink);
        transition: transform 0.18s ease, background 0.18s ease;
      }
      .epilog__btn--primary {
        background: var(--sw-accent);
        border-color: var(--sw-accent);
        color: #fff;
      }
      .epilog__btn:hover {
        transform: translateY(-2px);
      }
      .epilog__btn:focus-visible {
        outline: 3px solid var(--sw-accent);
        outline-offset: 3px;
      }

      @media (prefers-reduced-motion: reduce) {
        .epilog__btn {
          transition: none;
        }
        .epilog__btn:hover {
          transform: none;
        }
      }

      .epilog__legal {
        margin-top: clamp(3rem, 8vh, 5rem);
        padding-top: 1.6rem;
        border-top: 1px solid #e6d6bf;
        font-size: 0.85rem;
        color: var(--sw-ink-soft);
      }
      .epilog__legal nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.4rem 1.4rem;
        margin-bottom: 0.9rem;
      }
      .epilog__legal a {
        color: var(--sw-ink);
        text-decoration: none;
        border-bottom: 1px solid color-mix(in srgb, var(--sw-ink) 28%, transparent);
        padding-bottom: 1px;
      }
      .epilog__legal a:hover {
        border-bottom-color: var(--sw-accent);
        color: var(--sw-accent);
      }
      .epilog__legal p {
        margin: 0;
      }
      .epilog__note {
        margin: 0 0 0.5rem !important;
        font-size: 0.78rem;
        opacity: 0.8;
      }
    </style>

    <script is:inline>
      // Erst auf Klick starten und dann die nativen Controls freigeben, damit die
      // dunkle Leiste nicht dauerhaft auf der Cremefläche liegt.
      (function () {
        var btn = document.querySelector("[data-play-video]");
        var vid = document.getElementById("epilog-video");
        if (!btn || !vid) return;
        // JS ist da: native Controls weg, eigener Button her.
        vid.controls = false;
        btn.hidden = false;
        btn.addEventListener("click", function () {
          vid.closest(".epilog__vwrap").classList.add("is-playing");
          vid.controls = true;
          vid.play();
          btn.hidden = true;
        });
      })();
    </script>

    <script is:inline src="/scrollworld/scrub-engine.js"></script>
    <script
      is:inline
      set:html={`mountScrollWorld(document.getElementById('world'), ${JSON.stringify(config)});`}
    />

    <script is:inline>
      // Der Epilog gehört in die Topbar-Navigation, aber NICHT in die Route-Rail
      // rechts: deren Punkte markieren die Szenen des Kameraflugs ("05 / 05"),
      // ein sechster Punkt würde ein sechstes Diorama versprechen, das es nicht
      // gibt, und den Zähler verstimmen. Deshalb wird hier nur die Nav ergänzt.
      (function () {
        var nav = document.querySelector(".sw-nav");
        var target = document.getElementById("epilog");
        if (!nav || !target) return;

        var b = document.createElement("button");
        b.type = "button";
        b.className = "sw-nav__item sw-nav__item--epilog";
        b.textContent = "Die Menschen";
        b.addEventListener("click", function () {
          window.scrollTo(0, target.offsetTop);
        });
        nav.appendChild(b);

        // Die Engine rendert ihre Buttons ohne target. Externe Ziele (Calendly)
        // sollen einen neuen Tab öffnen — sonst landet der Zurück-Button auf der
        // frisch geladenen Startseite bei Scroll 0 und der ganze Flug ist weg.
        document.querySelectorAll('.sw-btn[href^="http"], .sw-topcta[href^="http"]').forEach(function (a) {
          a.target = "_blank";
          a.rel = "noopener";
        });

        // Active-State. Die Engine aktualisiert Nav und Route-Rail nur, wenn sich
        // die Sektion ändert (`if (near !== activeIndex)`); beim Scrollen in den
        // Epilog bleibt `near` auf der letzten Szene stehen. Sie überschreibt uns
        // also nicht laufend — es genügt, die beiden Übergänge zu behandeln:
        // rein  → eigenen Eintrag aktiv, Szenen-Einträge aus.
        // raus  → Engine-Zustand aus der Route-Rail spiegeln, die weiterhin
        //         korrekt gepflegt wird (identische Reihenfolge wie die Nav).
        var scenes = nav.querySelectorAll(".sw-nav__item:not(.sw-nav__item--epilog)");
        var dots = document.querySelectorAll(".sw-route__dot");

        function setActive(inEpilog) {
          b.classList.toggle("is-active", inEpilog);
          for (var i = 0; i < scenes.length; i++) {
            scenes[i].classList.toggle(
              "is-active",
              !inEpilog && dots[i] && dots[i].classList.contains("is-active")
            );
          }
        }

        if ("IntersectionObserver" in window) {
          new IntersectionObserver(
            function (entries) {
              setActive(entries[0].isIntersecting);
            },
            // Schmales Band in der Viewport-Mitte: der Eintrag wird aktiv, sobald
            // der Epilog die Mitte überquert — nicht schon beim Hereinschieben.
            { rootMargin: "-45% 0px -45% 0px" }
          ).observe(target);
        }
      })();
    </script>
  </body>
</html>
