---
// Domvesta homepage. Visual language after Anton Skvortsov's "AI company
// website concept" (wireframe orb, wide uppercase type). Copy and mobile layout:
// the customer's mockups (16.10.2026, transcribed in docs/copy_v4.md); desktop
// shows the same content, with a few longer texts (.d-only / .m-only).
// Self-contained on purpose: no global stylesheet, no site layout.
//
// Desktop: a pinned, full-viewport stage scrubs the opening: the orb hero
// (text left, orb right, highlights along the bottom) → the benefit panel
// wipes up. Phones: no pinned stage; text first, the orb in its own stage
// below, then the highlights, and every section scrolls normally.
//
// Colours: the customer's palette (DESIGN.md, Oct 2026). Cream background,
// night navy #191625 for headings, icons, numbering and dark surfaces, grey
// #625f64 for supporting text, orange #fa641b for accents and contact surfaces.
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/schibsted-grotesk/400.css";
import "@fontsource/schibsted-grotesk/500.css";
import "@fontsource/instrument-serif/400.css";
import Nav from "../components/Nav.astro";
import { lg, sm, type LgIcon, type SmIcon } from "../components/icons";
import { counter, ctaLink, founders, mail, phone } from "../data/site";

const highlights = ["Digitaler Überblick", "Konditionen optimieren", "Persönlich betreut"];

// text: phones (mobile mockup); long: desktop (screenshot of 16.10.2026).
const benefits: { icon: LgIcon; title: string; text: string; long: string }[] = [
  {
    icon: "docCheck",
    title: "Unterlagen griffbereit",
    text: "Verträge und Abrechnungen je Liegenschaft digital finden.",
    long: "Verträge und Abrechnungen je Liegenschaft digital finden – statt in Ordnern und E-Mails zu suchen.",
  },
  {
    icon: "chartSearch",
    title: "Konditionen im Blick",
    text: "Preise und Leistungen vergleichen. Optimierungs­möglichkeiten erkennen.",
    long: "Wir vergleichen Preise und Leistungen und zeigen, wo sich Ihr Bestand optimieren lässt.",
  },
  {
    icon: "personSignal",
    title: "Abstimmung abgeben",
    text: "Wir übernehmen die Kommunikation mit Energie- und Versicherungspartnern.",
    long: "Wir übernehmen die Kommunikation mit Energie- und Versicherungspartnern und bleiben Ihre Anlaufstelle.",
  },
];

// The "Lieferstellenportal" card is an illustration, not a working UI.
// Phones show four tiles (mobile mockup); desktop a small dashboard.
const portal: { icon: SmIcon; label: string }[] = [
  { icon: "doc", label: "Verträge" },
  { icon: "doc", label: "Dokumente" },
  { icon: "list", label: "Meine Anliegen" },
  { icon: "person", label: "Kontakt" },
];

type BoardRow = { icon: SmIcon; label: string; accent?: boolean };
const boardNav: (BoardRow & { active?: boolean })[][] = [
  [
    { icon: "homeFill", label: "Übersicht", active: true },
    { icon: "doc", label: "Verträge" },
    { icon: "doc", label: "Dokumente" },
    { icon: "list", label: "Meine Anliegen" },
  ],
  [
    { icon: "person", label: "Benutzerprofil" },
    { icon: "mail", label: "Kontakt" },
    { icon: "help", label: "FAQ" },
  ],
];
const boardCards: { icon: SmIcon; title: string; rows: BoardRow[] }[] = [
  {
    icon: "doc",
    title: "Meine Verträge",
    rows: [
      { icon: "bolt", label: "Strom", accent: true },
      { icon: "flame", label: "Gas" },
    ],
  },
  {
    icon: "person",
    title: "Kontaktdaten",
    rows: [
      { icon: "phone", label: "Telefon" },
      { icon: "mobile", label: "Mobiltelefon" },
      { icon: "mail", label: "E-Mail-Adresse" },
    ],
  },
  {
    icon: "doc",
    title: "Aktuelle Dokumente",
    rows: [
      { icon: "doc", label: "Verträge" },
      { icon: "doc", label: "Jahresabrechnungen" },
      { icon: "filePlus", label: "Weitere Dokumente" },
    ],
  },
];

const tasks: { icon: SmIcon; label: string }[] = [
  { icon: "gauge", label: "Zählerstände melden" },
  { icon: "bars", label: "Abschläge ändern" },
  { icon: "doc", label: "Rechnungsadresse ändern" },
  { icon: "card", label: "Bankverbindung aktualisieren" },
  { icon: "bank", label: "SEPA-Mandate verwalten" },
  { icon: "pencil", label: "Verträge kündigen" },
  { icon: "filePlus", label: "Weitere Verträge importieren" },
];

const insurance: { icon: LgIcon; title: string; text: string }[] = [
  { icon: "shieldCheck", title: "Schutz und Beitrag optimieren", text: "Verträge prüfen. Angebote verständlich vergleichen." },
  { icon: "docsStack", title: "Unterlagen digital erhalten", text: "Policen und Beitragsrechnungen zentral bei uns hinterlegt." },
  { icon: "building", title: "Neue Objekte integrieren", text: "Wir klären die Aufnahme mit dem Versicherer." },
];

const choices = [
  {
    title: "Das passende Preismodell",
    text: "Festpreis oder flexible Konditionen: Unterschiede, Chancen und Risiken verstehen.",
  },
  { title: "Den richtigen Schutz", text: "Leistungen und Beiträge für Ihren Bestand vergleichen." },
  { title: "Abläufe, die entlasten", text: "Digitale Unterlagen und persönliche Betreuung berücksichtigen." },
];

const steps = [
  { title: "Bestand kennenlernen", text: "Ziele besprechen und benötigte Unterlagen klären." },
  { title: "Angebote vergleichen", text: "Wir sichten Ihre Daten und erklären passende Angebote." },
  {
    title: "Gemeinsam umsetzen",
    text: "Nach Ihrer Entscheidung und den nötigen Freigaben koordinieren wir die Umstellung.",
  },
];

const faq: { q: string; a: string }[] = [
  {
    q: "Wie viel Aufwand haben wir?",
    a: "Sie stellen Unterlagen und Freigaben bereit. Wir sichten die Daten, stimmen Schritte ab und begleiten die Umsetzung.",
  },
  {
    q: "Welche Kosten entstehen?",
    a: "Für unsere Beratung entstehen Ihnen keine Kosten. Bei erfolgreicher Vermittlung erhalten wir eine Provision vom Energieversorger oder von der Versicherungsgesellschaft.",
  },
  {
    q: "Müssen alle Verträge gleichzeitig wechseln?",
    a: "Nein. Wir berücksichtigen Laufzeiten und Kündigungsfristen. Ihr Bestand kann schrittweise in die neue Lösung überführt werden.",
  },
  {
    q: "Können neue Liegenschaften dazukommen?",
    a: "Ja. Wir begleiten die Aufnahme in die bestehende Rahmenvertragslösung und klären die jeweiligen Konditionen und Voraussetzungen mit dem Anbieter.",
  },
  {
    q: "Wer betreut uns nach dem Abschluss?",
    a: "Domvesta bleibt Ihre persönliche Anlaufstelle. Wir unterstützen Sie bei Rückfragen und Veränderungen sowie bei der Abstimmung mit den Anbietern. Über Versicherungsleistungen und Schadenregulierung entscheidet der Versicherer.",
  },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={new URL("/", Astro.site)} />
    <title>Domvesta – Strom, Gas und Versicherungen für Hausverwaltungen</title>
    <meta
      name="description"
      content="Strom, Gas und Versicherungen für Hausverwaltungen: Verträge bündeln, Unterlagen digital finden, Fristgerechte Abrechnung."
    />
  </head>
  <body>
    <Nav />

    <main>
      <!-- ============ 01–02: pinned opening (hero → benefit cards) ============ -->
      <div class="track" id="top">
        <div class="pin" style="--t2:0">
          <div class="hero">
            <div class="hero-bg" aria-hidden="true"></div>
            <div class="hero-text">
              <span class="count hero-count" aria-hidden="true">{counter(1)}</span>
              <section class="hero-main" aria-labelledby="hero-title">
                <span class="eyebrow">Für Hausverwaltungen</span>
                <h1 id="hero-title">
                  Strom. Gas.<br />Versicherung.<br /><em>Ein Ansprechpartner.</em><br />Weniger Aufwand.
                </h1>
              </section>
              <div class="hero-side">
                <p class="hero-lede">
                  Verträge bündeln. Unterlagen digital finden. Fristgerechte Abrechnung.<span class="d-only">{" "}Wir bringen Struktur in Ihren Bestand und kümmern uns um die Kommunikation mit den Anbietern.</span>
                </p>
                <a class="btn btn-solid" {...ctaLink}>Erstgespräch vereinbaren</a>
                <span class="cta-note">Unverbindlich kennenlernen</span>
              </div>
              <!-- Desktop: the right part of the hero, behind the text layer.
                   Phones: its own stage between the CTA and the highlights. -->
              <div class="orb-stage" aria-hidden="true">
                <div class="rings"><span></span><span></span></div>
                <div class="bokeh"><i></i><i></i><i></i><i></i></div>
                <canvas class="orb"></canvas>
              </div>
              <ul class="highlights">
                {highlights.map((h) => <li>{h}</li>)}
              </ul>
            </div>

            <span class="count count-fixed" aria-hidden="true" data-first={counter(1)} data-next={counter(2)}>{counter(1)}</span>
          </div>

          <section class="services" id="leistungen" aria-labelledby="leistungen-title">
            <span class="count services-count" aria-hidden="true">{counter(2)}</span>
            <header class="services-head">
              <h2 id="leistungen-title">
                Weniger suchen.<br /><span class="d-only">Weniger abstimmen.<br /></span>Mehr Überblick.
              </h2>
              <p>
                Viele Anbieter, verstreute Unterlagen, offene Rückfragen? <span class="m-only">Wir bringen Ordnung hinein.</span><span
                  class="d-only">Wir machen daraus klare Abläufe.</span
                >
              </p>
            </header>
            <div class="cards">
              {
                benefits.map((b) => (
                  <article class="card">
                    <span class="card-icon" set:html={lg(b.icon)} />
                    <div class="card-copy">
                      <h3>{b.title}</h3>
                      <p>
                        <span class="m-only">{b.text}</span><span class="d-only">{b.long}</span>
                      </p>
                    </div>
                  </article>
                ))
              }
            </div>
            <p class="tagline"><span>Alter Verwalter,</span> <span> ist das einfach!</span></p>
          </section>
        </div>
      </div>

      <!-- ============ 03: Strom & Gas ============ -->
      <section class="sec" id="strom-gas" aria-labelledby="strom-gas-title">
        <span class="count">{counter(3)}</span>
        <header class="sec-head reveal">
          <h2 id="strom-gas-title">Strom und Gas.<br />Digital geordnet.</h2>
          <p class="lede">
            Ihre eingebundenen Lieferstellen im Portal des ausgewählten Anbieters. Wir unterstützen bei Einrichtung und
            Lieferantenkommunikation.
          </p>
        </header>
        <div class="energy">
          <figure class="portal reveal">
            <figcaption class="portal-head">
              <span>
                <strong class="portal-title">Lieferstellenportal</strong>
                <span class="portal-sub">Illustrative Ansicht</span>
              </span>
              <span class="portal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            </figcaption>
            <!-- Phones -->
            <ul class="portal-tiles" aria-hidden="true">
              {
                portal.map((t) => (
                  <li>
                    <Fragment set:html={sm(t.icon)} />
                    <span>{t.label}</span>
                    <Fragment set:html={sm("chevron", "chev")} />
                  </li>
                ))
              }
            </ul>
            <!-- Desktop: sidebar + four cards -->
            <div class="portal-board" aria-hidden="true">
              <ul class="pd-nav">
                {
                  boardNav.map((group, g) => (
                    <>
                      {g > 0 && <li class="pd-sep" />}
                      {group.map((n) => (
                        <li class:list={{ active: n.active }}>
                          <Fragment set:html={sm(n.icon)} />
                          {n.label}
                        </li>
                      ))}
                    </>
                  ))
                }
              </ul>
              {
                boardCards.map((c) => (
                  <div class="pd-card">
                    <div class="pd-head">
                      <Fragment set:html={sm(c.icon)} />
                      <span>{c.title}</span>
                      <Fragment set:html={sm("chevron", "chev")} />
                    </div>
                    <ul>
                      {c.rows.map((row) => (
                        <li>
                          <Fragment set:html={sm(row.icon, row.accent ? "accent" : "")} />
                          <span>{row.label}</span>
                          <Fragment set:html={sm("chevron", "chev")} />
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
              <div class="pd-card pd-help">
                <div class="pd-head">
                  <Fragment set:html={sm("help")} />
                  <span>Hilfe &amp; Unterstützung</span>
                  <Fragment set:html={sm("chevron", "chev")} />
                </div>
                <div class="pd-help-body">
                  <Fragment set:html={lg("support")} />
                  <p>Wir unterstützen bei Fragen rund um das Portal und helfen bei Ihren Anliegen.</p>
                </div>
              </div>
            </div>
          </figure>
          <ol class="rows">
            <li class="row reveal">
              <span class="big-num">01</span>
              <div>
                <h3>Unterlagen griffbereit</h3>
                <p>Verträge und Jahresabrechnungen digital einsehen.</p>
              </div>
            </li>
            <li class="row reveal" style="--d:1">
              <span class="big-num">02</span>
              <div>
                <h3>Vorgänge einfacher erledigen</h3>
                <ul class="tasks">
                  {
                    tasks.map((t) => (
                      <li>
                        <Fragment set:html={sm(t.icon)} />
                        {t.label}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </li>
            <li class="row reveal" style="--d:2">
              <span class="big-num">03</span>
              <div>
                <h3>Bestand erweitern</h3>
                <p>Neue Liegenschaften integrieren.</p>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <!-- ============ 04: Versicherungen ============ -->
      <section class="sec" id="versicherungen" aria-labelledby="versicherungen-title">
        <span class="count">{counter(4)}</span>
        <header class="sec-head reveal">
          <h2 id="versicherungen-title">Passender Schutz.<br />Weniger Aufwand.</h2>
          <p class="lede">Rahmenverträge für Gebäudeversicherungen mit Blick auf Beitrag, Leistung und Verwaltung.</p>
        </header>
        <div class="tiles">
          {
            insurance.map((t, i) => (
              <article class="tile reveal" style={`--d:${i}`}>
                <span class="row-num">0{i + 1}</span>
                <span class="tile-icon" set:html={lg(t.icon)} />
                <div class="tile-copy">
                  <h3>{t.title}</h3>
                  <p>{t.text}</p>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="claim reveal" aria-labelledby="claim-title">
          <h3 id="claim-title" class="claim-title">Auch im Schadenfall<br />an Ihrer Seite.</h3>
          <p>Wir begleiten Meldung und Abstimmung. Die digitale Bearbeitung wird von einer KI unterstützt.</p>
        </aside>
      </section>

      <!-- ============ 05: Klar entscheiden (dark) ============ -->
      <section class="sec dark" id="entscheidung" aria-labelledby="entscheidung-title">
        <span class="count">{counter(5)}</span>
        <div class="dark-glow" aria-hidden="true"></div>
        <header class="dark-head reveal">
          <h2 id="entscheidung-title">Gut entscheiden.<br />Klar begründen.</h2>
          <p class="lede">Wir machen Angebote verständlich.</p>
        </header>
        <ol class="choices">
          {
            choices.map((c, i) => (
              <li class="reveal" style={`--d:${i}`}>
                <span class="choice-num">0{i + 1}</span>
                <h3>{c.title}</h3>
                <p>{c.text}</p>
              </li>
            ))
          }
        </ol>
        <p class="glow-text reveal">Nachvollziehbar entscheiden –<br />auch in der Eigentümerversammlung.</p>
      </section>

      <!-- ============ 06: Team ============ -->
      <section class="sec team" id="team" aria-labelledby="team-title">
        <span class="count">{counter(6)}</span>
        <div class="team-grid">
          <h2 id="team-title" class="reveal">Persönlich da.<br />Langfristig an Ihrer Seite.</h2>
          <figure class="team-photo reveal">
            <div class="team-rings" aria-hidden="true"><span></span><span></span></div>
            <img
              src="/team-800.webp"
              srcset="/team-800.webp 800w, /team.webp 1254w"
              sizes="(max-width: 720px) 88vw, 46vw"
              width="800"
              height="800"
              alt="Joshua de Buhr und Ben Siefkes"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="team-copy">
            <p class="lede reveal">
              Wir sind Joshua de Buhr und Ben Siefkes. Wir nehmen Ihr Anliegen auf und koordinieren die nächsten Schritte.
            </p>
            <div class="people">
              {
                founders.map((f, i) => (
                  <details class="person reveal" style={`--d:${i}`}>
                    <summary>
                      <span>
                        <span class="person-name">{f.name.split(" ")[0]}</span>
                        <span class="person-role">{f.role}</span>
                      </span>
                      <Fragment set:html={sm("chevron", "chev")} />
                    </summary>
                    <ul>
                      {f.points.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </details>
                ))
              }
            </div>
            <p class="team-note reveal">Ein Team. Eine zentrale Anlaufstelle.</p>
            <a class="btn btn-solid btn-arrow reveal" {...ctaLink}>Lernen wir uns kennen <Fragment set:html={sm("arrow")} /></a>
          </div>
        </div>
        <aside class="trust reveal" aria-labelledby="trust-title">
          <div>
            <h3 id="trust-title">Beratung ist Vertrauenssache.</h3>
            <p>
              Erfahren Sie auf ProvenExpert, wie Kunden die persönliche Finanz- und Versicherungsberatung von Ben Siefkes
              bewerten.
            </p>
          </div>
          <a
            class="btn btn-line"
            href="https://www.provenexpert.com/de-de/ben-siefkes-finanz-und-versicherungsmakler/"
            target="_blank"
            rel="noopener"
          >
            Kundenbewertungen zu Ben Siefkes ansehen ↗
          </a>
        </aside>
      </section>

      <!-- ============ 07: So starten wir ============ -->
      <section class="sec" id="ablauf" aria-labelledby="ablauf-title">
        <span class="count">{counter(7)}</span>
        <header class="sec-head reveal">
          <h2 id="ablauf-title">Einfach starten.<br />Klar begleitet.</h2>
          <p class="lede">Sie geben die Richtung vor.<br />Wir übernehmen die Abstimmung.</p>
        </header>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li class="step reveal" style={`--d:${i}`}>
                <span class="step-dot" aria-hidden="true" />
                <span class="big-num">0{i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="roles reveal">
          <div class="role">
            <span class="role-label">Ihr Beitrag</span>
            <p>Unterlagen und Freigaben.</p>
          </div>
          <div class="role">
            <span class="role-label">Unser Beitrag</span>
            <p>Prüfung, Abstimmung und Begleitung.</p>
          </div>
          <a class="btn btn-solid btn-arrow" {...ctaLink}>Erstgespräch vereinbaren <Fragment set:html={sm("arrow")} /></a>
        </div>
      </section>

      <!-- ============ 08: FAQ ============ -->
      <section class="sec" id="faq" aria-labelledby="faq-title">
        <span class="count">{counter(8)}</span>
        <div class="split">
          <div class="split-head reveal">
            <h2 id="faq-title">Ihre Fragen.<br />Klare Antworten.</h2>
            <p class="lede">Damit Sie wissen, was auf Sie zukommt.</p>
          </div>
          <div class="faq reveal">
            {
              faq.map((f, i) => (
                <details open={i === 0}>
                  <summary>
                    {f.q}
                    <span class="plus" aria-hidden="true" />
                  </summary>
                  <p>{f.a}</p>
                </details>
              ))
            }
            <p class="faq-note">Konditionen und Leistungsumfang klären wir transparent im Gespräch.</p>
          </div>
        </div>
      </section>

      <!-- ============ 09: Kontakt ============ -->
      <section class="sec contact" id="kontakt" aria-labelledby="kontakt-title">
        <span class="count">{counter(9)}</span>
        <div class="contact-rings" aria-hidden="true"><span></span><span></span></div>
        <div class="contact-glow" aria-hidden="true"></div>
        <div class="contact-body">
          <span class="kicker reveal">Strom · Gas · Versicherung</span>
          <h2 id="kontakt-title" class="reveal">Weniger Aufwand<br />beginnt mit einem Gespräch.</h2>
          <p class="lede reveal">Wir besprechen Ihren Bestand und zeigen, wo wir Ihre Verwaltung entlasten können.</p>
          <div class="contact-cta reveal">
            <a class="btn btn-solid" {...ctaLink}>Erstgespräch vereinbaren</a>
            <span class="cta-note">Unverbindlich kennenlernen.</span>
          </div>
          <div class="reach reveal">
            <p>Lieber schreiben?<br /><a href={`mailto:${mail}`}>{mail}</a></p>
            <p>Lieber telefonieren?<br /><a href={phone.href}>{phone.label}</a></p>
          </div>
          <p class="signoff reveal">Alter Verwalter, ist das einfach.</p>
        </div>
      </section>
    </main>

    <footer class="foot">
      <span>© Domvesta</span>
      <nav aria-label="Rechtliches">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </nav>
    </footer>

    <script>
      import { mountOrb } from "../scripts/orb";

      const track = document.querySelector<HTMLElement>(".track")!;
      const pin = document.querySelector<HTMLElement>(".pin")!;
      const nav = document.querySelector<HTMLElement>(".nav")!;
      const services = document.querySelector<HTMLElement>(".services")!;
      const countFixed = document.querySelector<HTMLElement>(".count-fixed")!;
      const orbStage = document.querySelector<HTMLElement>(".orb-stage")!;
      // Same query as the CSS phone block: no pinned stage there (see placeOrb, update).
      const phoneMq = window.matchMedia("(max-aspect-ratio: 1/1), (max-width: 720px)");
      const navLinks = document.querySelectorAll<HTMLElement>("[data-nav]");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function safeMount<T>(label: string, fn: () => T): T | null {
        try {
          return fn();
        } catch (err) {
          // No WebGL: the CSS layers still carry the composition.
          console.warn(`[domvesta] ${label} disabled:`, err);
          return null;
        }
      }
      const orbCanvas = document.querySelector<HTMLCanvasElement>("canvas.orb")!;
      // placeOrb() sizes and centres it in its stage.
      const orb = safeMount("orb", () =>
        mountOrb(orbCanvas, {
          // Night-navy cage around the orange core, like the logo's cubes around the hexagon.
          colors: { shell: 0x191625, inner: 0x625f64, nodes: 0x191625, smoke: 0x9a3d0c, edgeGlow: 0xfa7a35 },
        }),
      );
      if (!orb) orbCanvas.remove();

      // The canvas fills its stage (desktop: the right part of the hero; phones:
      // a block of its own). Cage size and centre are set explicitly; the rings
      // follow via --orb / --cy on the stage.
      function placeOrb() {
        const w = orbCanvas.clientWidth;
        const h = orbCanvas.clientHeight;
        if (!w || !h) return;
        const phone = phoneMq.matches;
        const y = phone ? h / 2 : h * 0.48;
        const size = phone ? w * 0.6 : Math.min(h * 0.58, w * 0.66);
        orbStage.style.setProperty("--cy", `${y.toFixed(1)}px`);
        orbStage.style.setProperty("--orb", `${size.toFixed(1)}px`);
        orb?.setFrame({ y, size });
      }
      placeOrb();

      // --- pinned opening: p runs 0→1 over the track: short hold on the hero, then the wipe
      const clamp = (v: number) => Math.min(1, Math.max(0, v));
      const seg = (p: number, a: number, b: number) => {
        const x = clamp((p - a) / (b - a));
        return x * x * (3 - 2 * x);
      };
      const maxScroll = () => track.offsetHeight - window.innerHeight;

      const setActive = (id: string | null) =>
        navLinks.forEach((a) => a.classList.toggle("active", a.dataset.nav === id));

      // Sections with their own ids; filled by the observer further down.
      const visible = new Set<string>();
      let pinnedActive: string | null = null;
      let queued = false;
      function update() {
        queued = false;
        if (phoneMq.matches) {
          // Phones: hero and cards are normal sections; just pause the orb
          // while its stage is off screen.
          const r = orbStage.getBoundingClientRect();
          orb?.setProgress(0, r.bottom > 0 && r.top < window.innerHeight ? 0 : 1);
          nav.classList.toggle("solid", window.scrollY > 4);
          pinnedActive = null;
          if (!visible.size) setActive(null);
          return;
        }
        const max = maxScroll();
        const p = max > 0 ? clamp((window.scrollY - track.offsetTop) / max) : 0;
        const t2 = seg(p, 0.2, 0.75);
        pin.style.setProperty("--t2", t2.toFixed(4));
        countFixed.textContent = (t2 > 0.5 ? countFixed.dataset.next : countFixed.dataset.first) ?? "";
        orb?.setProgress(0, t2);

        // Transparent over the pinned opening, frosted once
        // normal sections start scrolling underneath.
        nav.classList.toggle("solid", window.scrollY > track.offsetTop + max - 1);
        pinnedActive = t2 > 0.5 ? "leistungen" : null;
        if (!visible.size) setActive(pinnedActive);
      }
      const queue = () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      };
      const relayout = () => {
        placeOrb();
        queue();
      };
      window.addEventListener("scroll", queue, { passive: true });
      window.addEventListener("resize", relayout);
      phoneMq.addEventListener("change", relayout);
      update();

      // Jumps into the pinned timeline go to a progress value, not an element
      // (on phones the cards are a normal section after the hero).
      const gotoTop = (step: number) =>
        phoneMq.matches
          ? step === 0
            ? 0
            : services.getBoundingClientRect().top + window.scrollY
          : track.offsetTop + step * maxScroll();
      document.querySelectorAll<HTMLElement>("[data-goto]").forEach((el) =>
        el.addEventListener("click", (e) => {
          e.preventDefault();
          window.scrollTo({ top: gotoTop(Number(el.dataset.goto)), behavior: reduce ? "auto" : "smooth" });
        }),
      );
      // Same for arriving with #leistungen (e.g. from the legal pages): on
      // desktop the cards live inside the pinned stage, so the browser's own
      // anchor jump stays on the hero.
      const jumpToHash = () => {
        if (location.hash === "#leistungen") window.scrollTo({ top: gotoTop(1), behavior: "instant" });
      };
      jumpToHash();
      window.addEventListener("load", jumpToHash, { once: true });

      // --- active nav link: whichever section crosses the middle of the viewport
      const sections = [...document.querySelectorAll<HTMLElement>("main > section[id]")];
      const navIo = new IntersectionObserver(
        (entries) => {
          for (const e of entries) e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id);
          const current = sections.find((s) => visible.has(s.id));
          setActive(current ? current.id : pinnedActive);
        },
        { rootMargin: "-45% 0px -50% 0px" },
      );
      sections.forEach((s) => navIo.observe(s));

      // --- reveal-on-scroll for the normal sections
      const revealIo = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add("in");
            revealIo.unobserve(e.target);
          }
        },
        { rootMargin: "0px 0px -12% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => revealIo.observe(el));
    </script>

