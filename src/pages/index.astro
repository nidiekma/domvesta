---
// ============================================================================
// Domvesta — Startseite (Scroll-World)
// ----------------------------------------------------------------------------
// Scroll-gescrubbter Kameraflug durch eine Papercraft-Dioramenwelt. Die Kamera
// taucht in jede Szene hinein und fliegt über einen Connector-Clip nahtlos in
// die nächste — keine Schnitte. Danach der Epilog mit den echten Gründern.
//
// ACHTUNG — bewusste Entscheidung des Kunden (Juli 2026): diese Seite hat den
// bisherigen One-Pager vollständig ersetzt. Damit sind Leistungstexte,
// 5-Schritte-Ablauf, Kontaktformular und die Experten-Stichpunkte NICHT mehr
// auf der Seite; die zugehörigen Exporte in site.ts (about, services, process,
// ticker, interessensbereiche) werden aktuell nirgends gerendert. Der alte
// One-Pager liegt in der Git-Historie (bis Commit 4758143,
// src/layouts/DomvestaSite.astro) und lässt sich jederzeit zurückholen.
// Conversion läuft jetzt über Calendly und E-Mail.
//
// Texte stammen 1:1 aus src/data/site.ts (kundenfreigegebene Formulierungen),
// nicht neu erfunden. Assets: public/scrollworld/.
// Engine: public/scrollworld/scrub-engine.js (vanilla, framework-agnostisch).
// ============================================================================
import "../styles/global.css";
import { site, founders, video } from "../data/site.ts";

const year = 2026;

const V = "/scrollworld/vid";

const config = {
  brand: { name: site.name, href: "/" },
  // Dauerhafter Buchungsweg in der Topbar. Ohne ihn erreicht ein Besucher, der
  // sofort buchen will, den ersten Calendly-Link erst nach ~7 Viewport-Höhen.
  // Der alte One-Pager hatte diesen CTA von der ersten Sekunde an.
  cta: { label: "Termin buchen", href: site.calendlyUrl },
  diveScroll: 1.3,
  // 1.3 statt 0.9: die Connectors hatten die KÜRZESTE Scroll-Strecke der Seite
  // (0,9vh = 760px am Telefon) bei gleichzeitig SCHNELLSTEM Ablauf (0,66 s Film
  // je 100px, gegenüber 0,40–0,52 bei den späteren Dives). Ein einziger
  // Daumen-Flick verschluckt damit den kompletten Übergang — er wirkt wie ein
  // harter Schnitt, obwohl der Clip durchgehend animiert. Jetzt bekommen sie
  // dieselbe Strecke wie die ersten beiden Dives.
  connScroll: 1.3,
  // Die Connector-Clips wurden auf den Frame bei -0,15 s des jeweiligen Dives
  // konditioniert — bei 24 fps fehlen an der Naht also ~3 Frames Kamerabewegung.
  // Etwas breiterer Crossfade als der Default (0.12) blendet genau das weg.
  crossfade: 0.18,
  hint: "Scrollen für die Tour",
  nav: true,
  atmosphere: true,
  // Nur für Besucher mit OS-Bedienhilfe "Bewegung reduzieren" sichtbar: die
  // starten in der kompakten Still-Tour und holen sich den Kameraflug bewusst
  // dazu (persistiert; Pille oben links, .sw-motion in der Engine). Alle
  // anderen Besucher sehen diesen Schalter nie.
  motionToggle: { on: "Animation einschalten", off: "Animation ausschalten" },
  // VERSUCH (Branch snappy-scroll): eine Scroll-Geste transportiert keine Pixel
  // mehr, sondern startet einen Flug zur nächsten Szene. Grund: zwischen zwei
  // Halten liegen ~15 Sekunden Film (Dive + Connector + halber Dive) — von Hand
  // sind das rund 30 Mausrad-Rasten pro Szene, und wer nicht durchhält, sieht die
  // Kernbotschaften nie. Jetzt genügt eine Raste, die Kamera fliegt selbst.
  snap: {
    // Ab dem Epilog scrollt die Seite wieder normal — dort steht Fließtext,
    // Teamfoto, Video und Footer, das darf kein Sprungziel-Raster bekommen.
    exit: "#epilog",
    // ~1,6-2,7 s je Übergang (die Abstände liegen bei 1,9-3,25 vh). Zwischen zwei
    // Halten liegen rund 15 s Film — der Flug läuft also mit gut 6-facher
    // Geschwindigkeit. Deutlich schneller wirkt er wie ein harter Schnitt,
    // deutlich langsamer verliert die Geste ihre Antwort.
    perVh: 820,
    min: 620,
    max: 3000,
  },
  sections: [
    {
      id: "liegenschaften",
      label: "Ihr Bestand",
      still: "/scrollworld/liegenschaften.webp",
      stillMobile: "/scrollworld/m/liegenschaften.webp",
      clip: `${V}/liegenschaften.mp4`,
      clipMobile: `${V}/m/liegenschaften.mp4`,
      accent: "#e8651b",
      eyebrow: "Für Hausverwaltungen",
      title: "Endlich Überblick statt Chaos.",
      body: "Alle Strom- und Gasverträge gebündelt in einem Portal. Digitale Versicherungslösungen. Und alles aus einer Hand.",
      tags: [],
    },
    {
      id: "papierkram",
      label: "Der Aufwand",
      still: "/scrollworld/papierkram.webp",
      stillMobile: "/scrollworld/m/papierkram.webp",
      clip: `${V}/papierkram.mp4`,
      clipMobile: `${V}/m/papierkram.mp4`,
      accent: "#6b5742",
      eyebrow: "Das Problem",
      title: "Zehn Ansprechpartner. Eine Aufgabe.",
      body: "Unterschiedliche Energieversorger, unübersichtliche Verträge und uneinheitliche Abrechnungen kosten Hausverwaltungen täglich Zeit und Nerven.",
      tags: [],
    },
    {
      id: "energie",
      label: "Strom & Gas",
      still: "/scrollworld/energie.webp",
      stillMobile: "/scrollworld/m/energie.webp",
      clip: `${V}/energie.mp4`,
      clipMobile: `${V}/m/energie.mp4`,
      accent: "#e8651b",
      scroll: 1.6,
      linger: 0.42,
      eyebrow: "Die Lösung",
      title: "Kein Überblick? War gestern.",
      body: "Ein Rahmenvertrag für Strom und einer für Gas. Und alle Unterlagen digital in einem Lieferstellenportal gebündelt.",
      tags: [],
    },
    {
      id: "versicherung",
      label: "Versicherungen",
      still: "/scrollworld/versicherung.webp",
      stillMobile: "/scrollworld/m/versicherung.webp",
      clip: `${V}/versicherung.mp4`,
      clipMobile: `${V}/m/versicherung.mp4`,
      accent: "#1f4e8c",
      scroll: 1.6,
      linger: 0.42,
      eyebrow: "Versicherungen",
      title: "Papierkram? War gestern.",
      body: "Ein Rahmenvertrag für alle Versicherungen rund um Ihre Liegenschaften. Alle Unterlagen digital. Und ein KI-basiertes Schadensmanagement.",
      tags: [],
    },
    {
      id: "gespraech",
      label: "Erstgespräch",
      still: "/scrollworld/gespraech.webp",
      stillMobile: "/scrollworld/m/gespraech.webp",
      clip: `${V}/gespraech.mp4`,
      clipMobile: `${V}/m/gespraech.mp4`,
      accent: "#e8651b",
      scroll: 1.8,
      linger: 0.5,
      eyebrow: "Ein Ansprechpartner",
      title: "Mehr Zeit für Hausverwaltungen.",
      body: "Energie & Versicherung aus einer Hand. Lernen wir uns in einem unverbindlichen Gespräch kennen.",
      // Die Bewertung MUSS Ben Siefkes zugeordnet werden, wo immer sie genannt
      // wird (§ 5 / § 5b Abs. 3 UWG) — das Profil gehört ihm persönlich, nicht
      // Domvesta. Siehe Kommentar an site.rating. Wortlaut wie im Laufband.
      tags: [
        `${site.rating.score} / ${site.rating.max} für ${site.rating.subject} auf ${site.rating.platform}`,
      ],
      cta: {
        primary: { label: "Erstgespräch buchen", href: site.calendlyUrl },
        // Zeigt bewusst nach unten statt nach außen: die Schlussszene wirkt mit
        // zwei Buttons wie das Seitenende, sonst sehen viele Teamfoto und Video
        // nie. Der Weg zur Hauptseite steht im Epilog.
        secondary: { label: "Die Menschen dahinter ↓", href: "#epilog" },
      },
    },
  ],
  connectors: [
    `${V}/conn1.mp4`,
    `${V}/conn2.mp4`,
    `${V}/conn3.mp4`,
    `${V}/conn4.mp4`,
  ],
  // Native 9:16-Kette (720x1280). Die Engine serviert sie auf Touch-Geräten bzw.
  // <=860px automatisch und fällt sonst auf die Desktop-Clips zurück. Bewusst
  // NICHT der Mittenausschnitt der Landscape-Fassung — die Szenen sind für
  // Hochformat neu komponiert, mit eigenen Portrait-Postern als stillMobile,
  // damit beim ersten Frame kein Landscape->Portrait-Sprung sichtbar wird.
  connectorsMobile: [
    `${V}/m/conn1.mp4`,
    `${V}/m/conn2.mp4`,
    `${V}/m/conn3.mp4`,
    `${V}/m/conn4.mp4`,
  ],
  // Cache-Buster für die Clip-Fetches (?av=…), Gegenstück zum ?v= an der
  // Engine-Einbindung unten: bei JEDER Änderung an den Videodateien hochzählen,
  // sonst serviert ein Telefon bis zu 10 Minuten alte Encodes aus dem
  // HTTP-Cache und ein frisch deployter Asset-Fix wirkt wie wirkungslos.
  // Stand 2: -g-4-Re-Encode der m/-Kette vom 2026-08-09.
  assetRev: 2,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: die Engine nutzt env(safe-area-inset-*) für Notch/Home-Indicator -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{site.name} — Energie & Versicherung für Hausverwaltungen</title>
    <meta
      name="description"
      content={`${site.name}: Betreuung rund um Strom & Gas und Versicherungen für Hausverwaltungen. Persönlich, digital und langfristig.`}
    />
  </head>
  <body>
    <!-- Die Engine rendert alle Überschriften als h2 und baut ihr DOM erst per JS.
         Ohne diesen h1 hätte die Startseite gar keine Hauptüberschrift. -->
    <h1 class="sr-only">{site.name} — {site.claim} {site.claimAccent}</h1>

    <div id="world"></div>

    <!-- Ohne JavaScript (oder wenn scrub-engine.js nicht lädt) bleibt #world leer.
         Deshalb hier dieselben Inhalte als statische Fassung — auch für Crawler,
         die kein JS ausführen. -->
    <noscript>
      <div class="nojs">
        {config.sections.map((s) => (
          <section class="nojs__scene">
            <img src={s.still} alt="" width="1536" height="1024" loading="lazy" decoding="async" />
            <p class="nojs__eyebrow">{s.eyebrow}</p>
            <h2 class="nojs__title">{s.title}</h2>
            <p class="nojs__body">{s.body}</p>
          </section>
        ))}
        <p class="nojs__cta">
          <a href={site.calendlyUrl} target="_blank" rel="noopener">Erstgespräch buchen</a>
        </p>
      </div>
    </noscript>

    <!-- ===================== HERO-CTA (nur Szene 01) =====================
      Zweiter Einstieg neben "Termin buchen" in der Topbar — bewusst mit anderer
      Tonlage: die Topbar fordert einen Termin, das hier ist der niedrigschwellige
      Weg ("prüfen", kostenlos). Deshalb auch orange statt Ink: zwei dunkle Pillen
      im selben Viewport läsen sich als derselbe Button, die Akzentfarbe trennt
      die beiden Angebote. Orange ist zudem der accent von Szene 01.

      Nicht über die per-Section-`cta`-Option der Engine gebaut, weil die nur
      Buttons unter dem Copy-Block links rendert — der Kunde hat die Position
      unten rechts markiert, als Gegengewicht zur Headline.

      Steht als statisches Markup im Body und wird per JS an die richtige Stelle
      gehängt (siehe Skript unten): Desktop in die .sw-copylayer (absolut unten
      rechts), Mobil in den Copy-Block von Szene 01, wo unten rechts kein Platz
      ist. Ohne JS bleibt es `hidden` — dann greift die .nojs-Fassung mit
      eigenem CTA.
    -->
    <div class="hero-cta" hidden>
      <p class="hero-cta__in">
        <span class="hero-cta__lead">Neugierig?</span>
        <a class="hero-cta__btn" href={site.calendlyUrl} target="_blank" rel="noopener">
          Kostenloses Entlastungspotenzial prüfen
          <span class="hero-cta__arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>

    <!-- ======================= EPILOG: die echten Menschen =======================
      Der Flug endet an einem leeren Papiertisch mit zwei Stühlen gegenüber. Hier
      wird aufgelöst, wer dort sitzt — Teamfoto und Video als Landung in der
      Realität. Damit erfüllt auch /welt das PRODUCT.md-Prinzip 2 (Vertrauen
      entsteht durch echte Menschen), das die reine KI-Bildwelt sonst unterläuft.

      Technisch: die Engine arbeitet komplett mit position:fixed (Sky z0, Stage z10,
      Copy z20, Route z40, Topbar z50) über einem hohen Track-Spacer. Der Epilog
      liegt danach im normalen Fluss und braucht nur z-index:45 + deckenden
      Hintergrund — über der Stage, aber unter der Topbar, damit die Nav bleibt.

      Hintergrund ist exakt --cream-deep #f6e8d3: das Video wurde ohne Alpha auf
      genau diesen Ton gerendert (siehe site.ts) und steht damit rahmenlos im
      Raum — so wie die Papier-Objekte in der Schlussszene um den Tisch schweben.
    -->
    <section class="epilog" id="epilog" aria-labelledby="epilog-title">
      <div class="epilog__inner">
        <p class="epilog__eyebrow">Und dahinter</p>
        <h2 class="epilog__title" id="epilog-title">
          Zwei Menschen. <em>Kein Callcenter.</em>
        </h2>
        <p class="epilog__lead">
          Die beiden Stühle am Tisch sind nicht dekorativ. Hier sind die zwei, die
          darauf sitzen.
        </p>

        <figure class="epilog__team">
          <img
            src="/team.webp"
            srcset="/team-800.webp 800w, /team.webp 1600w"
            sizes="(max-width: 900px) 92vw, 1080px"
            width="1600"
            height="1196"
            alt={`${founders[0].name} und ${founders[1].name} von ${site.name}`}
            loading="lazy"
            decoding="async"
          />
        </figure>

        <ul class="epilog__people">
          {founders.map((f) => (
            <li class="person">
              <span class="person__initials" aria-hidden="true">{f.initials}</span>
              <span class="person__text">
                <strong>{f.name}</strong>
                <span>{f.role}</span>
              </span>
            </li>
          ))}
        </ul>

        <!-- Video rahmenlos: gleicher Hintergrundton wie die Datei selbst.
             Bewusst OHNE native controls im Ruhezustand — die dunkle Controls-
             Leiste ist ein massiver Balken auf der Cremefläche und zerstört den
             schwebenden Eindruck. Erst beim Start werden die echten Controls
             eingeblendet (Scrubben/Ton bleiben also verfügbar). -->
        <div class="epilog__video">
          <h3 class="epilog__vtitle">{video.title}</h3>
          <p class="epilog__vlead">{video.lead}</p>
          <!-- Progressive Enhancement: `controls` steht im Markup, damit das Video
               auch ohne JS abspielbar bleibt. Erst wenn JS läuft, werden die
               Controls entfernt (dunkler Balken auf der Cremefläche) und
               stattdessen der eigene Play-Button eingeblendet. -->
          <div class="epilog__vwrap">
            <video
              id="epilog-video"
              controls
              playsinline
              preload="none"
              poster={video.poster}
              src={video.src}></video>
            <button class="epilog__play" type="button" data-play-video hidden>
              <span class="epilog__play-icon" aria-hidden="true"></span>
              Video abspielen
            </button>
          </div>
        </div>

        <div class="epilog__cta">
          <a
            class="epilog__btn epilog__btn--primary"
            href={site.calendlyUrl}
            target="_blank"
            rel="noopener"
          >
            Erstgespräch buchen
          </a>
          <!-- Mit dem Wegfall des Kontaktformulars ist E-Mail der einzige
               verbliebene Kanal neben Calendly. -->
          <a class="epilog__btn" href={`mailto:${site.email}`}>E-Mail schreiben</a>
        </div>

        <!-- Impressum und Datenschutz sind bei einem gewerblichen deutschen
             Auftritt Pflicht und müssen von jeder Seite aus erreichbar sein.
             Der alte One-Pager hatte sie im Footer — hier ist der Seitenschluss. -->
        <footer class="epilog__legal">
          <nav>
            {/* Zuordnung auch hier, siehe § 5 / § 5b Abs. 3 UWG. */}
            <a href={site.provenExpertUrl} target="_blank" rel="noopener">
              ProvenExpert ({site.rating.subject})
            </a>
            <a href="/impressum">Impressum</a>
            <a href="/datenschutz">Datenschutz</a>
          </nav>
          <p class="epilog__note">
            {site.rating.score} / {site.rating.max} aus {site.rating.count} Bewertungen für{" "}
            {site.rating.subject}, {site.rating.disclaimer}.
          </p>
          <p>© {year} {site.name}. Mit ❤ für Hausverwaltungen.</p>
        </footer>
      </div>
    </section>

    <style is:global>
      /* Theme-Tokens der Engine auf die Domvesta-Palette (DESIGN.md) mappen.
         Unlayered gewinnt gegen @layer sw der Engine — keine !important nötig.

         WICHTIG — .sw-root muss mit in den Selektor: die Engine deklariert ihre
         Defaults nicht auf :root, sondern auf .sw-root (dem #world-Container).
         Custom Properties werden vererbt, und dabei gewinnt immer der NÄHERE
         Vorfahre; Cascade Layers entscheiden nur zwischen Deklarationen auf
         DEMSELBEN Element. Ein Block allein auf :root war für alles innerhalb von
         #world deshalb wirkungslos — Titel liefen in ui-rounded/SF Pro Rounded
         statt Instrument Serif, --sw-ink war das kühle #241d2b der Engine statt
         Espresso, und --sw-bg (Himmel, Copy-Verlauf) war #F5EDE0 statt Warm Paper.
         Aufgefallen ist es nie, weil --sw-accent per Inline-Style aus der Config
         kommt und html/body außerhalb von .sw-root liegen. */
      :root,
      .sw-root {
        --sw-bg: #fbf2e4;
        --sw-ink: #2a1c10;
        --sw-ink-soft: #6b5742;
        --sw-accent: #e8651b;
        --sw-font-display: "Instrument Serif", Georgia, serif;
        --sw-font-body: "Schibsted Grotesk", system-ui, sans-serif;
      }

      /* Instrument Serif gibt es nur in 400. Die Engine setzt ihre Display-Rollen
         auf 700 — mit der echten Marken-Schrift wäre das ein synthetisch
         gefetteter Serif und damit genau das, was DESIGN.md unter "The Serif
         Speaks Rule" ausschließt. */
      .sw-copy__title {
        font-weight: 400;
      }
      /* Eyebrow und Markenname sind Label-Typografie, keine Display-Typografie:
         Instrument Serif darf laut DESIGN.md nicht klein und nicht funktional
         eingesetzt werden. */
      .sw-copy__eyebrow,
      .sw-brand__name {
        font-family: var(--sw-font-body);
      }
      html,
      body {
        margin: 0;
        background: var(--sw-bg);
      }
      /* Die Engine scrubbt currentTime aus der Scroll-Position — natives Smooth-
         Scrolling (global.css) würde dabei nachlaufen. */
      html {
        scroll-behavior: auto;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
      }

      /* FIX: Die Engine setzt pointer-events der ausgeblendeten Copy auf none,
         .sw-copy__cta trägt aber ein explizites pointer-events:auto — und ein
         Nachfahre mit auto bleibt laut Spec anklickbar, auch wenn ein Vorfahre
         none ist. Dadurch war der unsichtbare Calendly-Button der Schlussszene
         ab Scroll 0 unten links im Viewport klickbar. `inherit` übernimmt den
         Wert, den die Engine auf .sw-copy schreibt. Unlayered schlägt @layer sw. */
      .sw-copy__cta {
        pointer-events: inherit;
      }

      /* Der Hinweis "Scrollen für die Tour" wird nur auf opacity 0 geblendet,
         behält aber seine Fläche samt pointer-events und würde dort Taps
         schlucken. Er ist rein dekorativ. */
      .sw-hint {
        pointer-events: none;
      }

      /* Statische Fassung ohne JS */
      .nojs {
        max-width: 820px;
        margin: 0 auto;
        padding: clamp(2rem, 6vw, 4rem) clamp(1.2rem, 5vw, 3rem);
        font-family: var(--sw-font-body);
        color: var(--sw-ink);
      }
      .nojs__scene {
        margin-bottom: clamp(2.5rem, 6vw, 4rem);
      }
      .nojs__scene img {
        width: 100%;
        height: auto;
        border-radius: 22px;
      }
      .nojs__eyebrow {
        margin: 1.2rem 0 0.4rem;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--sw-accent);
      }
      .nojs__title {
        margin: 0 0 0.6rem;
        font-family: var(--sw-font-display);
        font-weight: 400;
        font-size: clamp(1.9rem, 4.5vw, 2.8rem);
        line-height: 1.05;
      }
      .nojs__body {
        margin: 0;
        color: var(--sw-ink-soft);
        line-height: 1.6;
      }
      .nojs__cta a {
        display: inline-block;
        padding: 0.95rem 1.7rem;
        border-radius: 999px;
        background: var(--sw-accent);
        color: #fff;
        font-weight: 600;
        text-decoration: none;
      }

      /* Die Engine zeichnet als Markenzeichen nur einen generischen Platzhalter
         (leeres <span> mit Verlauf) und kennt keine brand.logo-Option. Hier das
         echte Logo als Hintergrund — rein per CSS, damit beim Laden nicht kurz
         das Quadrat aufblitzt. Kein alt nötig: der Markenname steht als Text
         direkt daneben, das Zeichen ist dekorativ.
         logo.png ist 152x159 (rgba) — `contain` hält das Seitenverhältnis. */
      .sw-brand__mark {
        /* 34px statt der 24x28 des Platzhalters: das Zeichen ist fein
           gegliedert und wird darunter matschig. Die Hauptseite nutzt 38px,
           die kompaktere Topbar hier verträgt etwas weniger. */
        width: 34px;
        height: 34px;
        flex: none;
        border-radius: 0;
        background: url("/logo.png") center / contain no-repeat;
        box-shadow: none;
      }

      /* Nav-Eintrag zum Epilog: durch die Trennlinie als Sprungziel lesbar und
         nicht als sechste Szene des Flugs. */
      .sw-nav__item--epilog {
        border-left: 1px solid color-mix(in srgb, var(--sw-ink) 18%, transparent);
        margin-left: 4px;
      }

      /* ===================== HERO-CTA (Szene 01) ===================== */
      .hero-cta {
        /* Desktop: absolut in der .sw-copylayer (position:fixed; inset:0).
           Unten rechts — die Route-Rail sitzt vertikal mittig (y 50% ± ~100px)
           und die Scroll-Hint mittig unten, hier stört also nichts. Die untere
           Kante des Dioramas läuft je nach Viewport-Höhe in diesen Bereich; der
           Button legt sich dann leicht auf die Papierfläche, was zur Bildwelt
           passt (schwebende Papier-Objekte) und durch den Schatten getragen wird. */
        position: absolute;
        right: clamp(20px, 4vw, 56px);
        /* Untergrenze 104px, nicht 72: auf flachen Fenstern (~600px hoch) säße
           der Button sonst in der Scroll-Hint, die von unten 26px bis ~88px
           reicht. */
        bottom: clamp(104px, 12vh, 130px);
        z-index: 1;
        /* Der Titel braucht einzeilig 366–404px (je nach clamp-Stufe). 50vw
           hält ihn ab der Breakpoint-Grenze durchgehend auf einer Zeile, ohne
           in den Copy-Block links zu laufen. */
        max-width: min(50vw, 470px);
        font-family: var(--sw-font-body);
        /* Die Copylayer ist pointer-events:none; das Skript unten schaltet hier
           auf auto, sobald die Copy von Szene 01 sichtbar ist. */
      }
      .hero-cta[hidden] {
        display: none;
      }
      .hero-cta__in {
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
        text-align: right;
        /* Eigenes Element für die Eingangs-Animation: die Opacity des äußeren
           .hero-cta wird vom Skript mit dem Copy-Fade der Engine synchronisiert
           und darf davon nicht überschrieben werden. `backwards` hält den
           Startzustand während der Verzögerung — der CTA erscheint erst, wenn
           die Headline gelesen ist, und stiehlt ihr nicht die Aufmerksamkeit. */
        animation: hero-cta-in 0.55s 1.1s cubic-bezier(0.2, 0.7, 0.3, 1) backwards;
      }
      @keyframes hero-cta-in {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
      }
      .hero-cta__lead {
        /* Bewusst identisch zu .sw-copy__body der Engine (Zeile 405 in
           scrub-engine.js): gleiche Sans, gleiche Größe, gleiche Farbe. Der
           Zuruf soll wie ein weitergesprochener Satz des Fließtexts wirken,
           nicht wie eine zweite Headline. */
        font-family: var(--sw-font-body);
        font-size: clamp(1rem, 1.25vw, 1.14rem);
        line-height: 1.55;
        color: color-mix(in srgb, var(--sw-ink) 78%, var(--sw-ink-soft));
        /* Wo genau die Diorama-Kante liegt, hängt an der Fensterhöhe — auf
           flachen Fenstern steht die Zeile mitten in der Hecke. Deckender
           Cream-Halo statt einer Plakette: auf freier Fläche unsichtbar, über
           dem Bild trägt er die Schrift. */
        text-shadow: 0 0 10px var(--sw-bg), 0 0 20px var(--sw-bg),
          0 0 34px var(--sw-bg);
      }
      .hero-cta__btn {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 13px 24px;
        border-radius: 999px;
        background: var(--sw-accent);
        color: #fff;
        /* Größe und Gewicht wie .sw-copy__body — Kundenwunsch: der Button soll
           nicht schwerer wirken als der Fließtext daneben.
           ACHTUNG: Weiß auf #e8651b liegt bei 3,3:1. Als "large scale text"
           (>=18,66px fett) reichte das nach WCAG 1.4.3, in normaler Stärke
           gelten 4,5:1 — die erreicht diese Kombination nicht. Bewusst so
           entschieden zugunsten der Markenfarbe. Wer das drehen will: Füllung
           auf #c44f0d (4,7:1) oder Schrift auf var(--sw-ink) (5,0:1). */
        font-size: clamp(1rem, 1.25vw, 1.14rem);
        font-weight: 400;
        line-height: 1.4;
        text-decoration: none;
        /* Weicher Kontaktschatten wie bei den Papier-Objekten im Flug, leicht
           orange eingefärbt statt neutral grau. */
        box-shadow: 0 12px 26px -14px rgb(232 101 27 / 0.7),
          0 2px 8px -6px rgb(42 28 16 / 0.35);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .hero-cta__btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 30px -14px rgb(232 101 27 / 0.8),
          0 3px 10px -6px rgb(42 28 16 / 0.4);
      }
      .hero-cta__btn:focus-visible {
        outline: 3px solid var(--sw-ink);
        outline-offset: 3px;
      }
      .hero-cta__arrow {
        transition: transform 0.2s ease;
      }
      .hero-cta__btn:hover .hero-cta__arrow {
        transform: translateX(4px);
      }
      @media (prefers-reduced-motion: reduce) {
        .hero-cta__in {
          animation: none;
        }
        .hero-cta__btn,
        .hero-cta__arrow {
          transition: none;
        }
        .hero-cta__btn:hover {
          transform: none;
        }
      }

      /* Mobil hängt das Skript den CTA in den Copy-Block von Szene 01 (unten
         rechts ist dort die Copy selbst). Er läuft dann im Fluss mit, erbt
         Opacity/Transform/pointer-events der Engine und braucht keinen Sync. */
      @media (max-width: 860px) {
        .hero-cta {
          position: static;
          max-width: none;
          margin-top: 18px;
          /* Der Abstand zur Scroll-Hint wird jetzt von der Karte selbst getragen
             (.sw-copy:has(.hero-cta) weiter unten) — eine Untermarge hier läge
             INNERHALB der Karte und risse dort ein totes Feld auf. */
          margin-bottom: 0;
        }
        .hero-cta__in {
          align-items: flex-start;
          text-align: left;
          gap: 10px;
        }
        .hero-cta__btn {
          /* Der Titel bricht am Telefon auf zwei Zeilen: er bräuchte samt
             Polsterung ~358px, ein iPhone gibt im Copy-Block 324–351px her.
             Dann lieber bewusst über die volle Copy-Breite und zentriert,
             statt eines flatternden Blocks mit dem Pfeil weit außen.
             Nebeneffekt: großes Tap-Ziel. */
          width: 100%;
          justify-content: center;
          text-align: center;
          padding: 14px 20px;
        }
      }

      /* ============ SZENEN-COPY AM TELEFON: PAPIERKARTE ============
         Am Desktop steht die Copy links vor einem breiten Cream-Verlauf, der die
         Dioramen-Details wegdämpft. Am Telefon gibt es diesen Platz nicht: dort
         legt die Engine den Block über die volle Breite an den unteren Rand — also
         mitten in die Szene. Der Verlauf allein trug das nicht, sobald darunter
         etwas Kleinteiliges lag (die Ordnerstapel in "papierkram", die Kabelbäume
         und Zähler in "energie"): Espresso-Ink auf Mitteltönen ist zu wenig
         Kontrast, und der weiche text-shadow der Engine macht daraus Matsch statt
         Trennung.

         Statt den Verlauf weiter aufzudrehen (und die Szene damit zuzukleistern)
         bekommt der Block die Signatur aus DESIGN.md: eine weiße Karte mit 2px
         Espresso-Rand und hartem Offset-Schatten. Das ist im Papier-Diorama kein
         Fremdkörper, sondern ein aufgelegtes Schild — und der Kontrast ist ab
         jetzt vom Bild dahinter unabhängig.

         Zwei Karten überlagern sich nie: die Opacity-Kurven in read() (Szene 0
         fadet bis pr 0.62 aus, die mittleren sind an beiden Segmenträndern auf 0,
         die letzte startet bei pr 0) lassen immer nur eine gleichzeitig sichtbar
         sein. Unlayered schlägt @layer sw der Engine. */
      @media (max-width: 860px) {
        .sw-copy {
          background: #fff;
          border: 2px solid var(--sw-ink);
          border-radius: 22px;
          box-shadow: 6px 6px 0 var(--sw-ink);
          padding: 1.15rem 1.2rem 1.3rem;
          /* Rechts Platz für die Route-Rail: die sitzt am Telefon bei right:6px
             und ist mit Touch-Trefferfläche 40px breit. Solange die Copy frei
             schwebte, lagen die Punkte einfach über dem Bild; auf der deckenden
             Karte säßen sie auf Rand und Schatten und läsen sich als Fehler.
             50px = 46px Rail + 6px Karten-Schatten liegen damit knapp
             nebeneinander, die Lücke ist als "die Karte macht der Navigation
             Platz" lesbar. */
          right: 50px;
        }
        /* Der Copy-Block hängt am unteren Rand — eine Untermarge schiebt ihn also
           nach oben. Nur die Karte von Szene 01 braucht das: die Engine schiebt
           sie bei pr=0 zusätzlich um +2vh nach unten, und mit dem Hero-CTA darin
           liefe sie auf kurzen Displays (740px) in die Scroll-Hint, die dort auf
           zwei Zeilen umbricht. */
        .sw-copy:has(.hero-cta) {
          margin-bottom: 26px;
        }
        /* Die Halos der Engine sind für freistehende Schrift gedacht; auf Weiß
           sind sie nur ein schmutziger Schleier. */
        .sw-copy__title,
        .sw-copy__body {
          text-shadow: none;
        }
        /* Die Innenabstände der Engine sind auf den luftigen Desktop-Block
           gerechnet. In der Karte kostet jeder davon Höhe, und Szene 05 (Eyebrow,
           Titel, Text, Bewertungs-Pill, zwei Buttons) läuft sonst auf einem
           iPhone SE nach oben aus dem Bild. */
        .sw-copy__eyebrow {
          margin-top: 12px;
        }
        .sw-copy__body {
          margin-top: 12px;
        }
        .sw-copy__tags {
          margin-top: 16px;
        }
        .sw-copy__cta {
          margin-top: 18px;
        }
        /* Der große Cream-Verlauf hat jetzt nur noch eine Aufgabe: den Fuß der
           Szene beruhigen, wo Scroll-Hint und Home-Indicator liegen. Die Lesbarkeit
           trägt die Karte — also darf deutlich mehr Diorama sichtbar bleiben. */
        .sw-copylayer::before {
          height: 42%;
          background: linear-gradient(
            0deg,
            var(--sw-bg) 0%,
            color-mix(in srgb, var(--sw-bg) 86%, transparent) 16%,
            color-mix(in srgb, var(--sw-bg) 38%, transparent) 54%,
            transparent 100%
          );
        }
        /* Gegenstück oben. Am Desktop deckt der breite seitliche Verlauf der
           Copylayer auch die Topbar ab; am Telefon liegt der Verlauf nur unten
           und der Markenname stand blank auf der Szene — über den Ordnerstapeln
           in "papierkram" war "Domvesta" praktisch unlesbar. Bewusst ein
           weicher Verlauf statt der Cream-Leiste mit Ink-Kante aus DESIGN.md:
           eine harte Linie quer über den Kameraflug nähme der Welt das
           Schwebende. Liegt in der Copylayer (z20), also unter der Topbar (z50).
           Kein backdrop-filter — Blur kostet neben dem Video-Scrubbing zu viel. */
        .sw-copylayer::after {
          content: "";
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          height: calc(112px + env(safe-area-inset-top, 0px));
          background: linear-gradient(
            180deg,
            color-mix(in srgb, var(--sw-bg) 92%, transparent) 0%,
            color-mix(in srgb, var(--sw-bg) 62%, transparent) 46%,
            transparent 100%
          );
        }
      }

      /* ===================== EPILOG ===================== */
      .epilog {
        position: relative;
        /* über Stage (10) / Copy (20) / Route (40), unter Topbar (50) */
        z-index: 45;
        /* Exakt der Ton, auf den das Video gerendert wurde → rahmenlos. */
        background: #f6e8d3;
        color: var(--sw-ink);
        font-family: var(--sw-font-body);
