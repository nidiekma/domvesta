---
// Impressum — Daten übernommen von https://bensiefkes.de/impressum/
import LegalPage from "../layouts/LegalPage.astro";
import { legal } from "../data/site.ts";
---

<LegalPage title="Impressum">
  <h2>Angaben gemäß § 5 DDG</h2>
  <address>
    <strong>{legal.owners.join(" & ")}</strong><br />
    {legal.business}<br />
    {legal.street}<br />
    {legal.city}
  </address>

  <h3>Kontakt</h3>
  <p>
    Telefon: <a href={`tel:${legal.phoneHref}`}>{legal.phone}</a><br />
    E-Mail: <a href={`mailto:${legal.email}`}>{legal.email}</a>
  </p>

  <h2>Zulassungen &amp; Register</h2>
  <p>Die folgenden Angaben beziehen sich auf Ben Siefkes:</p>

  <h3>Vermittlerregister-Nummern</h3>
  <ul>
    <li>
      Versicherungsvermittler mit Erlaubnis nach § 34d Abs. 1 GewO:<br />
      Registrierungs-Nr. <strong>D-G6CT-WLA1I-16</strong>
    </li>
    <li>
      Finanzanlagenvermittler mit Erlaubnis nach § 34f Abs. 1 GewO:<br />
      Registrierungs-Nr. <strong>D-F-161-5KVD-04</strong>
    </li>
  </ul>
  <p>
    Die Registrierung kann im Vermittlerregister überprüft werden:<br />
    <a href="https://www.vermittlerregister.info" target="_blank" rel="noopener">www.vermittlerregister.info</a>
  </p>

  <h3>Zuständige Aufsichtsbehörde</h3>
  <p>
    IHK Oldenburg<br />
    Moslestraße 6<br />
    26122 Oldenburg
  </p>

  <h3>Berufshaftpflichtversicherung</h3>
  <p>
    Allianz Versicherungs-AG<br />
    Königinstr. 28<br />
    80802 München<br />
    Geltungsbereich: Deutschland
  </p>

  <h2>Streitbeilegung</h2>
  <p>
    Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:
    <a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener">https://ec.europa.eu/consumers/odr/</a><br />
    Unsere E-Mail-Adresse finden Sie oben im Impressum.
  </p>
  <p>
    Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer
    Verbraucherschlichtungsstelle teilzunehmen.
  </p>
</LegalPage>
