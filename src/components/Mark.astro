---
// Domvesta mark: two interlocked orbits, navy over orange at
// top and bottom, orange over navy left and right (masks cut the gaps, so the
// mark stays transparent). Small cut (heavier stroke) for the nav. Same
// geometry, keep in sync: public/favicon.svg (on a cream tile) and the
// favicon.ico (16/32/48) rendered from it / apple-touch-icon.png; public/logo.svg is the
// large cut (rx 51.6, stroke 5, like the reference image).
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<svg class={cls} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="dv-v"><path d="M50 50 0 0h100zM50 50 0 100h100z"/></clipPath>
    <clipPath id="dv-h"><path d="M50 50 0 0v100zM50 50 100 0v100z"/></clipPath>
    <mask id="dv-mn" maskUnits="userSpaceOnUse" x="-20" y="-20" width="140" height="140">
      <rect x="-20" y="-20" width="140" height="140" fill="#fff"/>
      <g clip-path="url(#dv-h)"><ellipse cx="50" cy="50" rx="52" ry="28.08" transform="rotate(-45 50 50)" fill="none" stroke="#000" stroke-width="16.50"/></g>
    </mask>
    <mask id="dv-mo" maskUnits="userSpaceOnUse" x="-20" y="-20" width="140" height="140">
      <rect x="-20" y="-20" width="140" height="140" fill="#fff"/>
      <g clip-path="url(#dv-v)"><ellipse cx="50" cy="50" rx="52" ry="28.08" transform="rotate(45 50 50)" fill="none" stroke="#000" stroke-width="16.50"/></g>
    </mask>
  </defs>
  <g transform="rotate(9 50 50)" fill="none" stroke-width="7.5">
    <g mask="url(#dv-mn)"><ellipse cx="50" cy="50" rx="52" ry="28.08" transform="rotate(45 50 50)" class="ring-navy" stroke="currentColor"/></g>
    <g mask="url(#dv-mo)"><ellipse cx="50" cy="50" rx="52" ry="28.08" transform="rotate(-45 50 50)" stroke="#fa641b"/></g>
  </g>
</svg>
