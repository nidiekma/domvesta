---
import "../styles/global.css";
import {
  site, founders, about, services, process, processIntroHtml,
  hero, ticker, interessensbereiche, video,
} from "../data/site.ts";

const year = 2026;

// Linien-Piktogramme (2px-Strich wie die Kartenränder, Farbe via currentColor)
// statt OS-Emoji, die je nach System unterschiedlich und "consumer-grade" rendern.
const icons: Record<string, string> = {
  shield: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>`,
  bolt: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  umbrella: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12a10 10 0 0 0-20 0Z"/><path d="M12 12v7a2 2 0 0 0 4 0"/><path d="M12 2v1"/></svg>`,
  mail: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  phone: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <title>{site.name} — Energie & Versicherung für Hausverwaltungen</title>
    <meta
      name="description"
      content={`${site.name}: Betreuung rund um Strom & Gas und Versicherungen für Hausverwaltungen. Persönlich, digital und langfristig.`}
    />
  </head>
  <body>
    <!-- ============================ NAV ============================ -->
    <header class="nav">
      <a class="brand" href="#top">
        <img src={site.logo} alt="" width="38" height="38" />
        <span>{site.name}</span>
      </a>
      <nav class="nav__links">
        <a href="#about">Wer wir sind</a>
        <a href="#leistungen">Was wir machen</a>
        <a href="#vorgehen">Ablauf</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
      <details class="nav__menu" data-nav-menu>
        <summary>Menü</summary>
        <div class="nav__menu-panel">
          <a href="#about">Wer wir sind</a>
          <a href="#leistungen">Was wir machen</a>
          <a href="#vorgehen">Ablauf</a>
          <a href="#kontakt">Kontakt</a>
          <a class="btn btn--solid nav__menu-cta" href="#termin">Termin buchen</a>
        </div>
      </details>
      <a class="btn btn--solid nav__cta" href="#termin">Termin buchen</a>
    </header>

    <main id="top">
      <!-- ============================ HERO ============================ -->
      <section class="hero">
        <div class="hero__blob" aria-hidden="true"></div>
        <div class="hero__inner">
          <div class="hero__copy">
            <span class="badge reveal" style="--d:.05s">
              <span class="badge__dot"></span> Für Hausverwaltungen
            </span>
            <h1 class="hero__title">
              {
                hero.lines.map((line, i) => (
                  <span
                    class={`reveal${i === 1 ? " hero__title--em" : ""}`}
                    style={`--d:${0.12 + i * 0.1}s`}
                    set:html={line}
                  />
                ))
              }
            </h1>
            <p class="hero__lead reveal" style="--d:.42s">{hero.lead}</p>
            <div class="hero__cta reveal" style="--d:.52s">
              <a class="btn btn--solid btn--lg" href="#termin">Kostenloses Erstgespräch</a>
              <a class="hero__rating" href={site.provenExpertUrl} target="_blank" rel="noopener">
                <strong>{site.rating.score}/{site.rating.max}</strong>
                <span class="hero__rating-stars" aria-hidden="true">★★★★★</span>
                <span>{site.rating.count} Bewertungen auf {site.rating.platform}</span>
              </a>
            </div>
          </div>
          <figure class="hero__media reveal" style="--d:.3s">
            <img
              src="/mfh_background.webp"
              srcset="/mfh_background-800.webp 800w, /mfh_background.webp 1537w"
              sizes="(max-width: 900px) 100vw, 45vw"
              alt="Fassade eines Mehrfamilienhauses in der Abendsonne"
              width="1537"
              height="1023"
              fetchpriority="high"
            />
          </figure>
        </div>
      </section>

      <!-- ============================ TICKER ============================ -->
      <div class="ticker" aria-hidden="true">
        <div class="ticker__track">
          {
            [...ticker, ...ticker].map((t) => (
              <span class="ticker__item">{t}<span class="ticker__star">✦</span></span>
            ))
          }
        </div>
      </div>

      <!-- ============================ ABOUT ============================ -->
      <section class="section about" id="about">
        <div class="about__label"><span>01</span> {about.label}</div>
        <h2 class="about__headline" set:html={about.headlineHtml}></h2>
        <div class="about__kurz">
          <span class="about__kurz-label">Kurz gesagt</span>
          {about.keywords.map((k) => <span class="chip">{k}</span>)}
        </div>
        <figure class="about__media">
          <img
            class="about__media-img"
            src="/team.webp"
            srcset="/team-800.webp 800w, /team.webp 1600w"
            sizes="(max-width: 900px) 90vw, 540px"
            alt="Ben Siefkes und Joshua de Buhr"
            width="1600"
            height="1196"
            loading="lazy"
          />
        </figure>
        <div class="about__narrative">
          {about.bodyHtml.map((p) => <p set:html={p}></p>)}
        </div>
        <div class="experts">
          {
            founders.map((f) => (
              <article class="expert">
                {/* <span class="expert__icon" aria-hidden="true" set:html={icons[f.icon]} /> */}
                <h3 class="expert__name">{f.name}</h3>
                <p class="expert__label">{f.label}</p>
                <ul class="expert__list">
                  {f.points.map((pt) => <li>{pt}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <!-- ============================ SERVICES ============================ -->
      <section class="section leistungen" id="leistungen">
        <div class="about__label"><span>02</span> Was wir machen</div>
        <h2 class="section__title">
          Zwei Bereiche, die wir Ihnen komplett <em>abnehmen.</em>
        </h2>
        <div class="svc-grid">
          {
            services.map((svc) => (
              <article class={`svc svc--${svc.id}`}>
                {/* <span class="svc__icon" aria-hidden="true" set:html={icons[svc.icon]} /> */}
                <h3 class="svc__title">{svc.title}</h3>
                <p class="svc__claim">{svc.claim}</p>
                <p class="svc__intro">{svc.intro}</p>
                <ul class="svc__list">
                  {svc.points.map((pt) => (
                    <li><strong>{pt.k}:</strong> {pt.v}</li>
                  ))}
                </ul>
                {"note" in svc && (
                  <div class="svc__note">
                    <span class="svc__note-title">
                      {/* <span class="svc__note-icon" aria-hidden="true" set:html={icons[svc.note.icon]} />  */}
                      {svc.note.title}
                    </span>
                    <p>{svc.note.body}</p>
                  </div>
                )}
                <div class="svc__result">
                  <span class="svc__result-label">Das Ergebnis</span>
                  <p>{svc.result}</p>
                </div>
              </article>
            ))
          }
        </div>

        <!-- Video: selbst gehostet, keine Drittanbieter-Verbindung. -->
        <div class="video">
          <div class="video__head">
            <h3 class="video__title">{video.title}</h3>
            <p class="video__lead">{video.lead}</p>
          </div>
          <div class="video__frame">
            <video controls playsinline preload="metadata" poster={video.poster} src={video.src}></video>
          </div>
        </div>
      </section>

      <!-- ============================ PROCESS ============================ -->
      <section class="section vorgehen" id="vorgehen">
        <div class="about__label"><span>03</span> So läuft's ab</div>
        <h2 class="section__title" set:html={processIntroHtml}></h2>
        <div class="proc">
          {
            process.map((p, i) => (
              <article class={`proc__row ${i % 2 === 1 ? "proc__row--alt" : ""}`}>
                <div class="proc__num">{p.step}</div>
                <div class="proc__text">
                  <h3>{p.title}</h3>
                  <div class="proc__tags">
                    {p.tags.map((t) => <span>{t}</span>)}
                  </div>
                  <p>{p.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- ============================ CONTACT ============================ -->
      <section class="section kontakt" id="kontakt">
        <div class="kontakt__card">
          <div class="kontakt__intro">
            <div class="about__label about__label--light"><span>04</span> Kontakt</div>
            <h2 class="kontakt__title">Schreiben Sie uns.<br />Wir antworten schnell.</h2>
            <p class="kontakt__lead">
              Kurz die Situation schildern — Sie bekommen zeitnah eine erste,
              unverbindliche Einschätzung von uns.
            </p>
            <div class="kontakt__meta">
              <a href={`mailto:${site.email}`}>
                <span class="kontakt__meta-icon" aria-hidden="true" set:html={icons.mail} /> {site.email}
              </a>
              <a href={`tel:${site.phoneHref}`}>
                <span class="kontakt__meta-icon" aria-hidden="true" set:html={icons.phone} /> {site.phone}
              </a>
            </div>
          </div>

          <div class="kontakt__formwrap" data-contact-wrapper>
            {
              !site.contactEndpoint && (
                <p class="form-note--demo">
                  Vorschau-Modus: Das Formular ist noch nicht mit einem
                  Versand-Dienst verbunden – Anfragen kommen so noch nicht an.
                </p>
              )
            }
            <form
              class="kontakt__form"
              method="post"
              data-contact-form
              data-endpoint={site.contactEndpoint}
              data-email={site.email}
            >
              <div class="field">
                <label for="p-name">Wie heißen Sie?</label>
                <input id="p-name" name="name" type="text" required placeholder="Vor- und Nachname" autocomplete="name" />
              </div>
              <div class="field">
                <label for="p-firma">Ihre Hausverwaltung</label>
                <input id="p-firma" name="firma" type="text" required placeholder="Firmenname" autocomplete="organization" />
              </div>
              <div class="field-row">
                <div class="field">
                  <label for="p-mail">E-Mail</label>
                  <input id="p-mail" name="email" type="email" required placeholder="name@firma.de" autocomplete="email" />
                </div>
                <div class="field">
                  <label for="p-tel">Telefon</label>
                  <input id="p-tel" name="telefon" type="tel" placeholder="optional" autocomplete="tel" />
                </div>
              </div>
              <div class="field">
                <label for="p-bereich">Worum geht's?</label>
                <select id="p-bereich" name="bereich">
                  {interessensbereiche.map((b) => <option value={b}>{b}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="p-msg">Ihre Nachricht</label>
                <textarea id="p-msg" name="nachricht" rows="3" placeholder="Erzählen Sie uns kurz, worum es geht …"></textarea>
              </div>
              <button class="btn btn--solid btn--full" type="submit">Anfrage abschicken</button>
              <p class="form-message" role="alert" hidden data-form-message></p>
              <p class="form-privacy">
                Mit dem Absenden stimmen Sie unserer
                <a href="/datenschutz">Datenschutzerklärung</a> zu.
              </p>
              <noscript>
                <p class="form-message">
                  Für das Formular ist JavaScript nötig – oder schreiben Sie uns
                  direkt an <a href={`mailto:${site.email}`}>{site.email}</a>.
                </p>
              </noscript>
            </form>
            <div class="form-success" role="status">
              <span class="form-success__mark" aria-hidden="true">✓</span>
              <h3>Danke, das ging raus!</h3>
              <p>Wir melden uns ganz bald persönlich bei Ihnen.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================ CALENDLY ============================ -->
      <section class="section termin" id="termin">
        <div class="about__label"><span>05</span> Termin buchen</div>
        <h2 class="section__title">Lieber direkt einen <em>Termin?</em></h2>
        <p class="termin__lead">Suchen Sie sich einfach einen passenden Slot aus.</p>
        <div class="calendly-frame" data-calendly data-url={site.calendlyUrl}>
          <div class="calendly-gate" data-calendly-gate>
            <p class="calendly-gate__hint">
              Der Terminkalender von Calendly wird erst nach Ihrem Klick geladen
              – vorher werden keine Daten an Calendly übertragen.
            </p>
            <button class="btn btn--solid" type="button" data-calendly-load>
              Terminkalender laden
            </button>
            <p class="calendly-gate__error" data-calendly-error hidden>
              ⚠ Der Kalender konnte nicht geladen werden. Nutzen Sie den
              Direktlink unten – dort finden Sie dieselben Termine.
            </p>
          </div>
        </div>
        <p class="termin__fallback">
          Der Kalender lädt nicht oder Sie mögen keine Einbettungen?
          <a href={site.calendlyUrl} target="_blank" rel="noopener">
            Termin direkt bei Calendly buchen ↗
          </a>
        </p>
      </section>
    </main>

    <!-- ============================ FOOTER ============================ -->
    <footer class="footer">
      <div class="footer__big">{site.name}</div>
      <div class="footer__row">
        <p>{site.claim} {site.claimAccent}</p>
        <nav class="footer__links">
          <a href={site.provenExpertUrl} target="_blank" rel="noopener">ProvenExpert</a>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </nav>
      </div>
      <p class="footer__copy">© {year} {site.name}. Mit ❤ für Hausverwaltungen.</p>
    </footer>

    <script>
      import "../scripts/contactForm.ts";
      import "../scripts/calendlyGate.ts";
      import "../scripts/navMenu.ts";
    </script>

    <style>
      :root {
        --cream: #fbf2e4;
        --cream-deep: #f6e8d3;
        --ink: #2a1c10;
        --ink-soft: #6b5742;
        --orange: #e8651b;
        --orange-deep: #cc4f0c;
        /* Textsicheres Orange: ≥4,5:1 auf Creme & Weiß (WCAG AA für Fließtext-Größen). */
        --orange-text: #b34509;
        --blue: #1f4e8c;
        --blue-soft: #dbe6f3;
        --line: #e6d6bf;
        --maxw: 1180px;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--cream);
        color: var(--ink);
        font-family: "Schibsted Grotesk", sans-serif;
        font-size: 17px; line-height: 1.6;
      }
      em { font-style: italic; }

      /* Sichtbarer Tastatur-Fokus im System-Stil; Formularfelder haben
         bereits eigene :focus-Ringe. */
      a:focus-visible, button:focus-visible {
        outline: 3px solid var(--blue); outline-offset: 2px; border-radius: 4px;
      }
      .btn:focus-visible { border-radius: 999px; }
      .footer a:focus-visible { outline-color: var(--cream); }
      .kontakt__intro a:focus-visible { outline-color: #fff; }
      /* Anker-Ziele nicht unter der Sticky-Nav verschwinden lassen. */
      [id] { scroll-margin-top: 5.5rem; }
      .field ::placeholder, .field input::placeholder, .field textarea::placeholder {
        color: var(--ink-soft); opacity: 1;
      }

      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
        padding: 0.9rem 1.6rem; border-radius: 999px; font-family: "Schibsted Grotesk", sans-serif;
        font-weight: 600; font-size: 1rem; text-decoration: none; cursor: pointer;
        border: 2px solid transparent; transition: transform .25s cubic-bezier(.2,.8,.2,1), background .25s, color .25s, box-shadow .25s;
      }
      .btn--solid { background: var(--orange); color: #fff; box-shadow: 0 12px 28px -12px rgba(232,101,27,0.8); }
      .btn--solid:hover { background: var(--orange-deep); transform: translateY(-3px) rotate(-1deg); }
      .btn--lg { padding: 1.05rem 2rem; font-size: 1.08rem; }
      .btn--full { width: 100%; }

      /* nav */
      .nav {
        position: sticky; top: 0; z-index: 30;
        max-width: var(--maxw); margin: 0 auto;
        display: flex; align-items: center; gap: 2rem;
        padding: 1rem clamp(1.2rem, 5vw, 3rem);
        background: color-mix(in srgb, var(--cream) 82%, transparent);
        backdrop-filter: blur(8px); border-bottom: 2px solid var(--ink);
      }
      .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1.4rem; }
      .brand img { border-radius: 9px; }
      .nav__links { display: flex; gap: 1.7rem; margin-left: auto; }
      .nav__links a { color: var(--ink); text-decoration: none; font-weight: 500; font-size: 0.95rem; position: relative; }
      .nav__links a::after {
        content: ""; position: absolute; left: 0; bottom: -3px; height: 2px; width: 100%;
        background: var(--orange); transform: scaleX(0); transform-origin: left;
        transition: transform .25s;
      }
      .nav__links a:hover::after { transform: scaleX(1); }

      /* Mobiles Menü (<details>) — erst unter 900px sichtbar */
      .nav__menu { display: none; position: relative; }
      .nav__menu summary {
        list-style: none; cursor: pointer; user-select: none;
        display: inline-flex; align-items: center; gap: 0.45rem;
        padding: 0.6rem 1.1rem; border: 2px solid var(--ink); border-radius: 999px;
        font-weight: 600; font-size: 0.95rem; color: var(--ink); background: #fff;
      }
      .nav__menu summary::-webkit-details-marker { display: none; }
      .nav__menu summary::before { content: "☰"; font-size: 0.9em; }
      .nav__menu[open] summary { background: var(--ink); color: var(--cream); }
      .nav__menu-panel {
        position: absolute; right: 0; top: calc(100% + 0.8rem); z-index: 40;
        min-width: 230px; display: grid; gap: 0.2rem; padding: 0.6rem;
        background: #fff; border: 2px solid var(--ink); border-radius: 14px;
        box-shadow: 6px 6px 0 var(--ink);
      }
      .nav__menu-panel a {
        display: block; padding: 0.8rem 1rem; border-radius: 10px;
        color: var(--ink); text-decoration: none; font-weight: 600; font-size: 1rem;
      }
      .nav__menu-panel a:hover, .nav__menu-panel a:focus-visible { background: var(--cream); }
      .nav__menu-panel .nav__menu-cta { display: flex; margin-top: 0.5rem; padding: 0.9rem 1rem; }
      .nav__menu-panel .nav__menu-cta:hover, .nav__menu-panel .nav__menu-cta:focus-visible { background: var(--orange-deep); }

      /* hero */
      .hero { position: relative; overflow: hidden; }
      .hero__blob {
        position: absolute; top: -10%; right: -8%; width: 60vw; max-width: 720px; aspect-ratio: 1;
        background: radial-gradient(circle at 35% 35%, rgba(232,101,27,0.18), transparent 62%),
                    radial-gradient(circle at 70% 65%, rgba(31,78,140,0.14), transparent 60%);
        border-radius: 50%; filter: blur(10px); z-index: 0;
      }
      .hero__inner {
        position: relative; z-index: 1; max-width: var(--maxw); margin: 0 auto;
        padding: clamp(3rem, 8vw, 6rem) clamp(1.2rem, 5vw, 3rem) clamp(2rem, 5vw, 4rem);
        display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        gap: clamp(2rem, 5vw, 4.5rem); align-items: center;
      }
      .hero__media { margin: 0; }
      .hero__media img { display: block; width: 100%; height: auto; border-radius: 22px; }
      .badge {
        display: inline-flex; align-items: center; gap: 0.5rem;
        font-weight: 600; font-size: 0.9rem; color: var(--blue);
        background: var(--blue-soft); padding: 0.45rem 1rem; border-radius: 999px;
      }
      .badge__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--orange); }
      .hero__title {
        font-family: "Instrument Serif", serif; font-weight: 400;
        font-size: clamp(2.8rem, 6.5vw, 5rem); line-height: 0.98;
        letter-spacing: -0.01em; margin: 1.4rem 0 0; color: var(--ink);
      }
      .hero__title span { display: block; }
      .hero__title--em { color: var(--orange); }
      .hero__title--em em { color: var(--blue); font-style: italic; }
      .hero__lead { font-size: 1.2rem; color: var(--ink-soft); max-width: 52ch; margin: 1.8rem 0 2.4rem; }
      .hero__cta { display: flex; align-items: center; gap: 1.6rem; flex-wrap: wrap; }
      .hero__rating { display: grid; text-decoration: none; color: var(--ink-soft); font-size: 0.9rem; line-height: 1.3; }
      .hero__rating strong { font-family: "Instrument Serif", serif; font-size: 1.6rem; color: var(--ink); }
      .hero__rating-stars { color: var(--orange); letter-spacing: 0.08em; }
      .hero__rating:hover strong { color: var(--orange); }

      /* ticker */
      .ticker {
        background: var(--ink); color: var(--cream); overflow: hidden;
        border-block: 2px solid var(--ink); padding: 0.8rem 0;
      }
      .ticker__track { display: inline-flex; white-space: nowrap; animation: scroll 30s linear infinite; }
      .ticker__item { font-family: "Instrument Serif", serif; font-size: 1.5rem; display: inline-flex; align-items: center; gap: 1.5rem; padding: 0 1.5rem; }
      .ticker__star { color: var(--orange); font-size: 1rem; }
      @keyframes scroll { to { transform: translateX(-50%); } }

      /* sections */
      .section {
        max-width: var(--maxw); margin: 0 auto;
        padding: clamp(3.5rem, 8vw, 6rem) clamp(1.2rem, 5vw, 3rem);
      }
      .about__label {
        display: inline-flex; align-items: center; gap: 0.6rem;
        font-weight: 600; font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--orange-text); margin-bottom: 1.6rem;
      }
      .about__label span {
        display: grid; place-items: center; width: 1.9rem; height: 1.9rem;
        background: var(--orange-text); color: #fff; border-radius: 50%; font-size: 0.8rem;
      }
      .about__label--light { color: var(--ink); }
      .about__label--light span { background: #fff; color: var(--orange-text); }
      .section__title {
        font-family: "Instrument Serif", serif; font-weight: 400;
        font-size: clamp(2.2rem, 5.5vw, 4rem); line-height: 1.02;
        margin: 0 0 2.6rem; color: var(--ink); max-width: 20ch;
      }
      .section__title em { color: var(--orange); }

      /* about */
      .about__headline {
        font-family: "Instrument Serif", serif; font-weight: 400;
        font-size: clamp(2.2rem, 5vw, 3.8rem); line-height: 1.03;
        margin: 0 0 2.4rem; color: var(--ink); max-width: 22ch;
      }
      .about__headline em { color: var(--orange); }
      .about__kurz { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin: 0 0 2.2rem; }
      .about__kurz-label {
        font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em;
        text-transform: uppercase; color: var(--blue); margin-right: 0.3rem;
      }
      .chip {
        display: inline-flex; align-items: center; padding: 0.4rem 1rem;
        border: 2px solid var(--ink); border-radius: 999px; background: #fff;
        font-weight: 600; font-size: 0.9rem; box-shadow: 3px 3px 0 var(--ink);
      }
      .about__media { margin: 0 0 2.4rem; }
      /* Freisteller-PNG: steht frei auf dem Seitenhintergrund, unten verankert. */
      .about__media-img {
        display: block; width: 100%; height: clamp(240px, 32vw, 400px);
        object-fit: contain; object-position: center bottom;
      }
      .about__narrative { max-width: 62rem; }
      .about__narrative p { margin: 0 0 1.2rem; color: var(--ink-soft); font-size: 1.12rem; }
      .about__narrative strong { color: var(--ink); }
      .about__narrative em { color: var(--blue); font-style: italic; }

      /* Experten-Karten (Kundenfeedback Juli 2026: statt langem Fließtext) */
      .experts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: 1.4rem; }
      .expert {
        background: #fff; border: 2px solid var(--ink); border-radius: 22px;
        padding: 1.9rem 1.8rem; box-shadow: 6px 6px 0 var(--ink);
        transition: transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s;
      }
      .expert:hover { transform: translate(-3px, -3px); box-shadow: 10px 10px 0 var(--orange); }
      .expert__icon { display: inline-block; color: var(--orange); line-height: 1; }
      /* set:html-SVGs bekommen Astros Scoping-Attribut nicht → :global() */
      .expert__icon :global(svg) { width: 2rem; height: 2rem; display: block; }
      .expert__name {
        font-family: "Instrument Serif", serif; font-weight: 400;
        font-size: 1.9rem; margin: 0.7rem 0 0.1rem; color: var(--ink);
      }
      .expert__label { margin: 0 0 1.1rem; font-weight: 700; color: var(--orange-text); }
      .expert__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
      .expert__list li { position: relative; padding-left: 1.6rem; color: var(--ink-soft); font-size: 0.96rem; }
      .expert__list li::before { content: "✓"; position: absolute; left: 0; top: 0; font-weight: 700; color: var(--orange-text); }

      /* services */
      .svc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; align-items: stretch; }
      .svc {
        position: relative; display: flex; flex-direction: column;
        background: #fff; border: 2px solid var(--ink);
        border-radius: 22px; padding: 2.2rem 1.8rem;
        box-shadow: 6px 6px 0 var(--ink);
        transition: transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s;
      }
      .svc:hover { transform: translate(-3px, -3px); box-shadow: 10px 10px 0 var(--orange); }
      .svc__icon { display: inline-block; color: var(--orange); line-height: 1; }
      .svc__icon :global(svg) { width: 2.2rem; height: 2.2rem; display: block; }
      .svc__title { font-family: "Instrument Serif", serif; font-weight: 400; font-size: 2rem; margin: 0.8rem 0 0.2rem; color: var(--orange); }
      .svc__claim { font-family: "Instrument Serif", serif; font-style: italic; font-size: 1.3rem; color: var(--blue); margin: 0 0 1.1rem; }
      .svc__intro { color: var(--ink-soft); margin: 0 0 1.1rem; font-size: 0.96rem; }
      .svc__list { list-style: none; margin: 0 0 1.2rem; padding: 0; display: grid; gap: 0.65rem; }
      .svc__list li { position: relative; padding-left: 1.6rem; color: var(--ink-soft); font-size: 0.96rem; }
      .svc__list li::before { content: "✓"; position: absolute; left: 0; top: 0; font-weight: 700; color: var(--orange-text); }
      .svc__list strong { color: var(--ink); }
      .svc__note {
        margin: 0 0 1.2rem; padding: 1.1rem 1.2rem;
        background: var(--blue-soft); border: 1.5px solid var(--blue); border-radius: 14px;
      }
      .svc__note-title { display: block; font-weight: 700; color: var(--blue); margin-bottom: 0.35rem; }
      .svc__note-icon :global(svg) { width: 1.15em; height: 1.15em; vertical-align: -0.2em; }
      .svc__note p { margin: 0; color: var(--ink); font-size: 0.94rem; }
      .svc__result {
        margin-top: auto; padding: 1.1rem 1.2rem;
        background: var(--cream); border: 1.5px solid var(--line); border-radius: 14px;
      }
      .svc__result-label {
        display: inline-block; font-weight: 700; font-size: 0.72rem; letter-spacing: 0.12em;
        text-transform: uppercase; color: var(--orange-text); margin-bottom: 0.35rem;
      }
      .svc__result p { margin: 0; font-weight: 500; color: var(--ink); font-size: 0.95rem; }

      /* video */
      .video { margin-top: 2.5rem; }
      .video__head { max-width: 60ch; }
      .video__title {
        font-family: "Instrument Serif", serif; font-weight: 400;
        font-size: 2rem; margin: 0 0 0.3rem; color: var(--blue);
      }
      .video__lead { margin: 0 0 1.4rem; color: var(--ink-soft); }
      .video__frame {
        aspect-ratio: 9 / 16; overflow: hidden; max-width: 420px; margin-inline: auto;
        border: 2px solid var(--ink); border-radius: 22px; background: var(--cream-deep);
        box-shadow: 6px 6px 0 var(--ink);
      }
      .video__frame video { display: block; width: 100%; height: 100%; object-fit: cover; }

      /* process */
      .proc { display: grid; gap: 1rem; }
      .proc__row {
        display: grid; grid-template-columns: auto 1fr; gap: clamp(1.2rem, 4vw, 3rem);
        align-items: center; background: #fff; border: 2px solid var(--ink); border-radius: 20px;
        padding: 1.6rem clamp(1.4rem, 3vw, 2.4rem); transition: transform .25s;
      }
      .proc__row:hover { transform: translateX(8px); }
      .proc__row--alt { background: var(--cream-deep); margin-left: clamp(0px, 6vw, 5rem); }
      .proc__num {
        font-family: "Instrument Serif", serif; font-size: clamp(3rem, 7vw, 5rem);
        line-height: 1; color: var(--orange); min-width: 2.4ch;
      }
      .proc__row--alt .proc__num { color: var(--blue); }
      .proc__text h3 { font-family: "Instrument Serif", serif; font-weight: 400; font-size: 1.7rem; margin: 0 0 0.3rem; color: var(--ink); }
      .proc__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 0.7rem; }
      .proc__tags span {
        font-size: 0.76rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
        color: var(--blue); background: var(--blue-soft); border-radius: 999px; padding: 0.25rem 0.75rem;
      }
      .proc__text p { margin: 0; color: var(--ink-soft); max-width: 70ch; }

      /* contact */
      .kontakt__card {
        display: grid; grid-template-columns: 1fr 1fr; gap: 0;
        border: 2px solid var(--ink); border-radius: 28px; overflow: hidden;
        box-shadow: 10px 10px 0 var(--ink);
      }
      .kontakt__intro { background: var(--orange); color: #fff; padding: clamp(2rem, 4vw, 3rem); }
      .kontakt__title { font-family: "Instrument Serif", serif; font-weight: 400; font-size: clamp(1.9rem, 3.4vw, 2.8rem); line-height: 1.05; margin: 0 0 1rem; }
      .kontakt__lead { color: var(--ink); margin: 0 0 2rem; }
      .kontakt__meta { display: grid; gap: 0.8rem; }
      .kontakt__meta a {
        display: flex; align-items: center; gap: 0.5rem; width: fit-content;
        color: var(--ink); text-decoration: none; font-weight: 600; font-size: 1.05rem;
      }
      .kontakt__meta-icon { display: inline-flex; }
      .kontakt__meta-icon :global(svg) { width: 1.05em; height: 1.05em; }
      .kontakt__meta a:hover { text-decoration: underline; }

      .kontakt__formwrap { background: #fff; padding: clamp(1.8rem, 4vw, 2.6rem); position: relative; }
      .field { margin-bottom: 1.1rem; }
      .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      .field label { display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 0.4rem; color: var(--ink); }
      .field input, .field select, .field textarea {
        width: 100%; padding: 0.85rem 1rem; border: 2px solid var(--line); border-radius: 12px;
        background: var(--cream); font-family: inherit; font-size: 1rem; color: var(--ink);
        transition: border-color .2s, box-shadow .2s;
      }
      .field input:focus, .field select:focus, .field textarea:focus {
        outline: none; border-color: var(--orange); box-shadow: 0 0 0 3px rgba(232,101,27,0.15);
      }
      .field textarea { resize: vertical; }

      .form-success { display: none; text-align: center; padding: 2.5rem 1rem; }
      [data-contact-wrapper].is-sent .kontakt__form { display: none; }
      [data-contact-wrapper].is-sent .form-success { display: block; }
      .form-success__mark {
        display: grid; place-items: center; width: 3.6rem; height: 3.6rem; margin: 0 auto 1rem;
        border-radius: 50%; background: var(--orange); color: #fff; font-size: 1.7rem; font-weight: 700;
      }
      .form-success h3 { font-family: "Instrument Serif", serif; font-weight: 400; font-size: 1.8rem; margin: 0 0 0.4rem; color: var(--orange); }
      .form-success p { margin: 0; color: var(--ink-soft); }

      /* Formular-Hinweise (Demo-Modus, Fehler, Datenschutz) */
      .form-note--demo {
        margin: 0 0 1.2rem; padding: 0.8rem 1.1rem;
        background: var(--blue-soft); border: 1.5px solid var(--blue); border-radius: 14px;
        color: var(--blue); font-weight: 600; font-size: 0.9rem;
      }
      .form-message {
        margin: 1.1rem 0 0; padding: 1rem 1.2rem;
        background: var(--cream); border: 1.5px solid var(--orange-deep); border-radius: 14px;
        color: var(--ink); font-size: 0.95rem; line-height: 1.5;
      }
      .form-message a { color: var(--blue); font-weight: 600; }
      .form-privacy { margin: 0.9rem 0 0; font-size: 0.85rem; color: var(--ink-soft); }
      .form-privacy a { color: var(--blue); font-weight: 600; }

      /* calendly */
      .termin__lead { color: var(--ink-soft); margin: -1.6rem 0 1.8rem; font-size: 1.1rem; }
      .calendly-frame {
        width: 100%;
        border: 2px solid var(--ink); border-radius: 24px; overflow: hidden; background: #fff;
        box-shadow: 10px 10px 0 var(--orange);
      }
      .calendly-gate {
        display: grid; justify-items: center; gap: 1.2rem; text-align: center;
        padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.2rem, 4vw, 3rem);
      }
      .calendly-gate__hint { margin: 0; max-width: 46ch; color: var(--ink-soft); }
      .calendly-gate__error {
        margin: 0; padding: 1rem 1.2rem; max-width: 46ch;
        background: var(--cream); border: 1.5px solid var(--orange-deep); border-radius: 14px;
        color: var(--ink); font-size: 0.95rem;
      }
      .termin__fallback { margin: 1.4rem 0 0; font-size: 0.9rem; color: var(--ink-soft); }
      .termin__fallback a { color: var(--blue); font-weight: 600; }
      .calendly-inline-widget { min-width: 320px; height: 680px; }
      /* Mobil höher: Calendlys Mobil-Layout ist ein langer vertikaler Fluss —
         so entsteht kein zweiter Scrollbalken im Seiten-Scroll (Scroll-Falle). */
      @media (max-width: 900px) {
        .calendly-inline-widget { height: 1100px; }
      }

      /* footer */
      .footer { background: var(--ink); color: var(--cream); padding: clamp(3rem, 6vw, 5rem) clamp(1.2rem, 5vw, 3rem) 2.5rem; }
      .footer__big {
        font-family: "Instrument Serif", serif; font-size: clamp(3rem, 14vw, 9rem); line-height: 0.9;
        text-align: center; color: var(--cream); max-width: var(--maxw); margin: 0 auto;
        border-bottom: 1px solid rgba(255,255,255,0.2); padding-bottom: 1.5rem;
      }
      .footer__row { max-width: var(--maxw); margin: 2rem auto 0; display: flex; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; align-items: center; }
      .footer__row p { margin: 0; opacity: 0.8; }
      .footer__links { display: flex; gap: 1.6rem; flex-wrap: wrap; }
      .footer__links a { color: var(--cream); text-decoration: none; font-weight: 500; }
      .footer__links a:hover { color: var(--orange); }
      .footer__copy { max-width: var(--maxw); margin: 2rem auto 0; text-align: center; opacity: 0.6; font-size: 0.85rem; }

      /* reveal */
      .reveal { opacity: 0; transform: translateY(20px); animation: reveal .8s cubic-bezier(.2,.8,.2,1) forwards; animation-delay: var(--d, 0s); }
      @keyframes reveal { to { opacity: 1; transform: translateY(0); } }

      /* responsive */
      @media (max-width: 900px) {
        .nav__links { display: none; }
        .nav__cta { display: none; }
        .nav__menu { display: block; margin-left: auto; }
        .hero__inner { grid-template-columns: 1fr; }
        .experts { grid-template-columns: 1fr; }
        .svc-grid { grid-template-columns: 1fr; }
        .kontakt__card { grid-template-columns: 1fr; }
        .proc__row--alt { margin-left: 0; }
      }
      @media (max-width: 520px) {
        .field-row { grid-template-columns: 1fr; }
        .footer__row { flex-direction: column; align-items: flex-start; }
        .nav { gap: 0.8rem; }
        .brand { font-size: 1.15rem; }
      }
    </style>
  </body>
</html>
