---
// Legal pages for the /lab/domvesta draft: same nav, wide type and brand
// palette as src/pages/lab/domvesta.astro (kept in sync by hand, the lab page
// is self-contained on purpose). The legal text itself comes from
// src/components/legal/ and is shared with the live /impressum and /datenschutz.
//
// A short warm intro band (eyebrow + title, rings and glow like the hero), then
// a sticky table of contents next to the text. The TOC is built from the
// text's <h2>s, so it follows the shared text without extra markup there.
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/schibsted-grotesk/400.css";
import "@fontsource/schibsted-grotesk/500.css";

interface Props {
  title: string;
  page: "impressum" | "datenschutz";
}

const { title, page } = Astro.props;
const home = "/lab/domvesta";

// "1. Datenschutz auf einen Blick" → number badge "01" + "Datenschutz auf einen Blick".
const pad = (n: number) => String(n).padStart(2, "0");
const toc: { id: string; num: string; label: string }[] = [];
const text = (await Astro.slots.render("default")).replace(/<h2>([\s\S]*?)<\/h2>/g, (_, inner: string) => {
  const num = pad(toc.length + 1);
  const label = inner.replace(/^\s*\d+\.\s*/, "");
  const id = `abschnitt-${num}`;
  toc.push({ id, num, label });
  return `<h2 id="${id}"><span class="h-num">${num}</span>${label}</h2>`;
});
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <title>{title} – Domvesta</title>
  </head>
  <body>
    <header class="nav">
      <a class="brand" href={home}>Domvesta</a>
      <nav class="links" aria-label="Hauptnavigation">
        <a href={`${home}#leistungen`}>Leistungen</a>
        <a href={`${home}#strom-gas`}>Strom &amp; Gas</a>
        <a href={`${home}#versicherungen`}>Versicherungen</a>
        <a href={`${home}#team`}>Über uns</a>
      </nav>
      <nav class="links end" aria-label="Rechtliches">
        <a href={`${home}/impressum`} class:list={{ active: page === "impressum" }} aria-current={page === "impressum" ? "page" : undefined}>Impressum</a>
        <a href={`${home}/datenschutz`} class:list={{ active: page === "datenschutz" }} aria-current={page === "datenschutz" ? "page" : undefined}>Datenschutz</a>
      </nav>
    </header>

    <main>
      <section class="intro" aria-labelledby="legal-title">
        <div class="rings" aria-hidden="true"><span></span><span></span></div>
        <div class="bokeh" aria-hidden="true"><i></i><i></i></div>
        <div class="intro-glow" aria-hidden="true"></div>
        <div class="intro-body">
          <span class="eyebrow">Rechtliches</span>
          <h1 id="legal-title">{title}</h1>
          <a class="back" href={home}>← Zurück zur Startseite</a>
        </div>
      </section>

      <div class="doc">
        <aside class="toc" aria-label="Inhalt">
          <span class="toc-label">Inhalt</span>
          <ol>
            {
              toc.map((t) => (
                <li>
                  <a href={`#${t.id}`} data-toc={t.id}>
                    <span class="row-num">{t.num}</span>
                    <span set:html={t.label} />
                  </a>
                </li>
              ))
            }
          </ol>
        </aside>
        <article class="prose" set:html={text} />
      </div>
    </main>

    <footer class="foot">
      <span>© Domvesta</span>
      <nav aria-label="Rechtliches">
        <a href={`${home}/impressum`}>Impressum</a>
        <a href={`${home}/datenschutz`}>Datenschutz</a>
      </nav>
    </footer>

    <script>
      const nav = document.querySelector<HTMLElement>(".nav")!;
      const intro = document.querySelector<HTMLElement>(".intro")!;
      const tocLinks = [...document.querySelectorAll<HTMLElement>("[data-toc]")];

      // Transparent over the intro band, frosted once the text scrolls under it.
      let queued = false;
      const update = () => {
        queued = false;
        nav.classList.toggle("solid", window.scrollY > intro.offsetHeight - nav.offsetHeight);
      };
      window.addEventListener(
        "scroll",
        () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );
      update();

      // TOC: highlight the section whose heading last crossed the upper third.
      const headings = tocLinks.map((a) => document.getElementById(a.dataset.toc!)!);
      const passed = new Set<string>();
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            // Above the band = passed; below it = not yet.
            if (e.isIntersecting || e.boundingClientRect.top < 0) passed.add(e.target.id);
            else passed.delete(e.target.id);
          }
          const current = [...headings].reverse().find((h) => passed.has(h.id));
          tocLinks.forEach((a) => a.classList.toggle("active", a.dataset.toc === current?.id));
        },
        { rootMargin: "0px 0px -66% 0px" },
      );
      headings.forEach((h) => io.observe(h));
    </script>

    <style is:global>
      :root {
        --pad: 3.6vw;
        --panel: #f6e8d3;
        --ink: #2a1c10;
        --text: #4a3826;
        --muted: #6b5742;
        --line: rgb(42 28 16 / 0.14);
        --orange: #e8651b;
        --blue: #1f4e8c;
      }
      html {
        background: var(--panel);
        scroll-padding-top: 110px;
      }
      @media (prefers-reduced-motion: no-preference) {
        html {
          scroll-behavior: smooth;
        }
      }
      body {
        margin: 0;
        color: var(--ink);
        font-family: "Schibsted Grotesk", system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a:focus-visible {
        outline: 2px solid var(--orange);
        outline-offset: 3px;
      }

      /* --- nav (as on /lab/domvesta) --- */
      .nav {
        position: fixed;
        inset: 0 0 auto;
        z-index: 50;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 3.4svh var(--pad) 2.6svh;
        font-family: "Archivo Variable", system-ui, sans-serif;
        font-stretch: 112%;
        text-transform: uppercase;
        color: var(--ink);
        transition: background-color 0.4s;
      }
      .nav::after {
        content: "";
        position: absolute;
        left: var(--pad);
        right: var(--pad);
        bottom: 0;
        height: 1px;
        background: var(--line);
      }
      .nav.solid {
        background: rgb(246 232 211 / 0.94);
        backdrop-filter: blur(16px) saturate(1.1);
        -webkit-backdrop-filter: blur(16px) saturate(1.1);
      }
      .brand {
        justify-self: start;
        color: inherit;
        text-decoration: none;
        font-size: clamp(12px, 1.05vw, 17px);
        letter-spacing: 0.02em;
      }
      .links {
        display: flex;
        gap: 3.6vw;
      }
      .links.end {
        justify-content: flex-end;
        gap: 3.4vw;
      }
      .links a {
        position: relative;
        color: inherit;
        text-decoration: none;
        font-size: clamp(9px, 0.68vw, 12px);
        letter-spacing: 0.04em;
        opacity: 0.8;
      }
      .links a:hover,
      .links a.active {
        opacity: 1;
      }
      .links a::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: calc(-2.6svh - 1px);
        width: max(100%, 3.6vw);
        height: 2px;
        translate: -50% 50%;
        border-radius: 2px;
        background: linear-gradient(90deg, transparent, #ff9a55 30%, var(--orange) 70%, transparent);
        box-shadow: 0 0 10px 2px rgb(240 120 40 / 0.5);
        opacity: 0;
        transition: opacity 0.4s;
      }
      .links a.active::after {
        opacity: 1;
      }

      /* --- intro band (a calm cut of the hero) --- */
      h1 {
        margin: 0;
        font-family: "Archivo Variable", system-ui, sans-serif;
        font-stretch: 125%;
        font-weight: 400;
        font-size: clamp(30px, 4.2vw, 72px);
        line-height: 1.08;
        letter-spacing: 0.005em;
        text-transform: uppercase;
        hyphens: manual;
      }
      .intro {
        --cy: 58%;
        position: relative;
        overflow: hidden;
        padding: 26svh var(--pad) 10svh;
        background:
          radial-gradient(45% 80% at 78% var(--cy), rgb(255 196 140 / 0.45), transparent 70%),
          linear-gradient(100deg, #ecd2b2 0%, #f2e0c8 38%, #f8ebda 72%, #fbf2e4 100%);
        border-bottom: 1px solid var(--line);
      }
      .rings,
      .bokeh {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .rings span {
        position: absolute;
        left: 78%;
        top: var(--cy);
        aspect-ratio: 1;
        translate: -50% -50%;
        border-radius: 50%;
      }
      .rings span:first-child {
        width: min(78svh, 70vw);
        border: 1px solid rgb(232 101 27 / 0.3);
      }
      .rings span:last-child {
        width: min(62svh, 56vw);
        border: 1px solid rgb(31 78 140 / 0.16);
        background: radial-gradient(closest-side, rgb(255 255 255 / 0.3), transparent);
      }
      .bokeh i {
        position: absolute;
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(circle, rgb(255 170 100 / 0.42), rgb(255 160 90 / 0.12) 60%, transparent 72%);
        border: 1px solid rgb(255 190 130 / 0.32);
        filter: blur(0.6px);
      }
      .bokeh i:nth-child(1) { left: 58%; top: 30%; width: 7svh; }
      .bokeh i:nth-child(2) { left: 92%; top: 74%; width: 10svh; opacity: 0.7; filter: blur(3px); }
      .intro-glow {
        position: absolute;
        left: 78%;
        bottom: -22svh;
        width: 60vw;
        height: 36svh;
        translate: -50% 0;
        background: radial-gradient(closest-side, rgb(255 140 60 / 0.4), rgb(255 130 50 / 0.12) 55%, transparent);
        filter: blur(30px);
        pointer-events: none;
      }
      .intro-body {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }
      .eyebrow {
        display: block;
        margin-bottom: 2.6svh;
        font: clamp(9px, 0.7vw, 11px) / 1 "Archivo Variable", sans-serif;
        font-stretch: 125%;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--blue);
      }
      .eyebrow::before {
        content: "";
        display: inline-block;
        width: 6px;
        height: 6px;
        margin-right: 10px;
        border-radius: 50%;
        background: var(--orange);
        box-shadow: 0 0 8px 2px rgb(240 120 40 / 0.5);
        vertical-align: 1px;
      }
      .back {
        margin-top: 5svh;
        padding: 10px 22px;
        border: 1px solid rgb(31 78 140 / 0.5);
        border-radius: 999px;
        font: 500 clamp(10px, 0.72vw, 12px) / 1.3 "Archivo Variable", sans-serif;
        font-stretch: 110%;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--blue);
        transition: background-color 0.3s, color 0.3s;
      }
      .back:hover {
        color: #fff;
        background: var(--blue);
      }

      /* --- document: sticky contents left, text right --- */
      .doc {
        display: grid;
        grid-template-columns: 30% minmax(0, 1fr);
        column-gap: 6vw;
        align-items: start;
        padding: 12svh var(--pad) 16svh;
      }
      .toc {
        position: sticky;
        top: 120px;
      }
      .toc-label,
      .row-num,
      .h-num {
        font: clamp(9px, 0.7vw, 11px) / 1 "Archivo Variable", sans-serif;
        font-stretch: 125%;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .toc-label {
        display: block;
        margin-bottom: 2.4svh;
        color: rgb(42 28 16 / 0.6);
      }
      .toc ol {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--line);
      }
      .toc a {
        position: relative;
        display: grid;
        grid-template-columns: 3.2em 1fr;
        align-items: baseline;
        padding: 1.6svh 0;
        border-bottom: 1px solid var(--line);
        color: var(--muted);
        text-decoration: none;
        font-size: clamp(13px, 0.92vw, 15px);
        line-height: 1.4;
        transition: color 0.3s;
      }
      .toc a:hover,
      .toc a.active {
        color: var(--ink);
      }
      .row-num,
      .h-num {
        color: var(--blue);
      }
      /* Active entry: the orange progress line from "Ablauf", running down the left edge. */
      .toc a::before {
        content: "";
        position: absolute;
        left: -1.2vw;
        top: 22%;
        bottom: 22%;
        width: 2px;
        border-radius: 2px;
        background: linear-gradient(180deg, #ff9a55, var(--orange));
        box-shadow: 0 0 10px 1px rgb(240 120 40 / 0.45);
        opacity: 0;
        transition: opacity 0.3s;
      }
      .toc a.active::before {
        opacity: 1;
      }

      .prose {
        max-width: 46em;
        font-size: clamp(14px, 1vw, 16px);
        line-height: 1.65;
        color: var(--muted);
        /* Long URLs in the text must break, or they widen the page on phones. */
        overflow-wrap: anywhere;
      }
      .prose h2 {
        margin: 10svh 0 3.6svh;
        padding-top: 4svh;
        border-top: 1px solid var(--line);
        font-family: "Archivo Variable", system-ui, sans-serif;
        font-stretch: 125%;
        font-weight: 400;
        font-size: clamp(18px, 1.55vw, 28px);
        line-height: 1.2;
        letter-spacing: 0.005em;
        text-transform: uppercase;
        color: var(--ink);
        hyphens: manual;
      }
      .prose h2:first-child {
        margin-top: 0;
        padding-top: 0;
        border-top: 0;
      }
      .h-num {
        display: block;
        margin-bottom: 1.8svh;
      }
      .prose h3 {
        margin: 5svh 0 1.4svh;
        font-size: clamp(17px, 1.3vw, 21px);
        font-weight: 400;
        line-height: 1.3;
        color: var(--ink);
      }
      .prose h4 {
        margin: 3svh 0 1svh;
        font-size: clamp(14px, 1vw, 16px);
        font-weight: 500;
        color: var(--ink);
      }
      .prose p {
        margin: 0 0 1.1em;
      }
      .prose strong {
        font-weight: 500;
        color: var(--ink);
      }
      .prose a {
        color: var(--blue);
        text-decoration-color: rgb(31 78 140 / 0.35);
        text-underline-offset: 3px;
        transition: color 0.2s, text-decoration-color 0.2s;
      }
      .prose a:hover {
        color: #c44f0d;
        text-decoration-color: var(--orange);
      }
      .prose ul {
        margin: 0 0 1.1em;
        padding-left: 1.2em;
      }
      .prose li {
        margin-bottom: 0.5em;
      }
      .prose li::marker {
        color: var(--orange);
      }
      /* Address blocks as the page's white-on-paper tiles. */
      .prose address {
        display: inline-block;
        min-width: min(100%, 22rem);
        box-sizing: border-box;
        margin: 0.4em 0 1.4em;
        padding: 3svh 2vw;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: linear-gradient(180deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.25));
        font-style: normal;
        color: var(--text);
      }

      .foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 3svh var(--pad);
        background: var(--panel);
        border-top: 1px solid var(--line);
        font-size: 12px;
        color: rgb(42 28 16 / 0.6);
      }
      .foot nav {
        display: flex;
        gap: 2vw;
      }
      .foot a {
        color: inherit;
        text-decoration: none;
      }
      .foot a:hover {
        color: var(--ink);
      }

      /* --- portrait / phone --- */
      @media (max-aspect-ratio: 1/1), (max-width: 720px) {
        :root {
          --pad: 6vw;
        }
        .links:not(.end) {
          display: none;
        }
        .nav {
          grid-template-columns: 1fr 1fr;
          padding: 2.6svh var(--pad) 2svh;
        }
        .brand {
          font-size: 14px;
        }
        .links a {
          font-size: 10px;
        }
        .links.end {
          gap: 6vw;
        }
        h1 {
          font-size: clamp(24px, 7.4vw, 40px);
          font-stretch: 106%;
        }
        .intro {
          --cy: 30%;
          padding: 20svh var(--pad) 7svh;
        }
        .rings span {
          left: 82%;
        }
        .rings span:first-child { width: 86vw; }
        .rings span:last-child { width: 68vw; }
        .bokeh i:nth-child(1) { left: 8%; top: 16%; }
        .back {
          margin-top: 3.6svh;
        }
        /* One column; the contents list stays as a jump list above the text. */
        .doc {
          grid-template-columns: minmax(0, 1fr);
          row-gap: 7svh;
          padding: 7svh var(--pad) 10svh;
        }
        .toc {
          position: static;
        }
        .toc a {
          font-size: 14px;
          grid-template-columns: 11vw 1fr;
        }
        .toc a::before {
          display: none;
        }
        .prose {
          font-size: 15px;
        }
        .prose h2 {
          font-size: clamp(17px, 5vw, 24px);
          font-stretch: 106%;
          margin-top: 8svh;
        }
        .prose address {
          padding: 18px 20px;
        }
        .foot {
          flex-direction: column;
          gap: 10px;
        }
        .foot nav {
          gap: 20px;
        }
      }
    </style>
  </body>
</html>
