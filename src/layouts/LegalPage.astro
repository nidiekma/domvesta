---
// Layout für rechtliche Unterseiten (Impressum, Datenschutz).
// Übernimmt Farbwelt & Typografie der Hauptseite (DomvestaSite.astro),
// aber mit schlanker Nav und Fließtext-Styling für lange Rechtstexte.
import "../styles/global.css";
import { site } from "../data/site.ts";

interface Props {
  title: string;
  description?: string;
}

const { title, description = `${title} von ${site.name}.` } = Astro.props;
const year = 2026;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} — {site.name}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>
    <header class="nav">
      <a class="brand" href="/">
        <img src={site.logo} alt="" width="38" height="38" />
        <span>{site.name}</span>
      </a>
      <nav class="nav__links">
        <a href="/#about">Wer wir sind</a>
        <a href="/#leistungen">Was wir machen</a>
        <a href="/#kontakt">Kontakt</a>
      </nav>
      <a class="btn btn--solid nav__cta" href="/#termin">Termin buchen</a>
    </header>

    <main class="legal">
      <a class="legal__back" href="/">← Zurück zur Startseite</a>
      <h1 class="legal__title">{title}</h1>
      <div class="legal__prose">
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="footer__row">
        <p>{site.claim} {site.claimAccent}</p>
        <nav class="footer__links">
          <a href={site.provenExpertUrl} target="_blank" rel="noopener">ProvenExpert</a>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </nav>
      </div>
      <p class="footer__copy">© {year} {site.name}. Mit ❤ für Hausverwaltungen.</p>
    </footer>

    <style is:global>
      :root {
        --cream: #fbf2e4;
        --cream-deep: #f6e8d3;
        --ink: #2a1c10;
        --ink-soft: #6b5742;
        --orange: #e8651b;
        --orange-deep: #cc4f0c;
        /* Textsicheres Orange: ≥4,5:1 auf Creme & Weiß (WCAG AA für Fließtext-Größen). */
        --orange-text: #b34509;
        --blue: #1f4e8c;
        --blue-soft: #dbe6f3;
        --line: #e6d6bf;
        --maxw: 1180px;
      }
      * { box-sizing: border-box; }
      a:focus-visible, button:focus-visible {
        outline: 3px solid var(--blue); outline-offset: 2px; border-radius: 4px;
      }
      .btn:focus-visible { border-radius: 999px; }
      .footer a:focus-visible { outline-color: var(--cream); }
      body {
        margin: 0;
        background: var(--cream);
        color: var(--ink);
        font-family: "Schibsted Grotesk", sans-serif;
        font-size: 17px; line-height: 1.6;
      }

      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
        padding: 0.9rem 1.6rem; border-radius: 999px; font-family: "Schibsted Grotesk", sans-serif;
        font-weight: 600; font-size: 1rem; text-decoration: none; cursor: pointer;
        border: 2px solid transparent; transition: transform .25s cubic-bezier(.2,.8,.2,1), background .25s;
      }
      .btn--solid { background: var(--orange); color: #fff; box-shadow: 0 12px 28px -12px rgba(232,101,27,0.8); }
      .btn--solid:hover { background: var(--orange-deep); transform: translateY(-3px) rotate(-1deg); }

      /* nav (wie Hauptseite) */
      .nav {
        position: sticky; top: 0; z-index: 30;
        max-width: var(--maxw); margin: 0 auto;
        display: flex; align-items: center; gap: 2rem;
        padding: 1rem clamp(1.2rem, 5vw, 3rem);
        background: color-mix(in srgb, var(--cream) 82%, transparent);
        backdrop-filter: blur(8px); border-bottom: 2px solid var(--ink);
      }
      .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1.4rem; }
      .brand img { border-radius: 9px; }
      .nav__links { display: flex; gap: 1.7rem; margin-left: auto; }
      .nav__links a { color: var(--ink); text-decoration: none; font-weight: 500; font-size: 0.95rem; position: relative; }
      .nav__links a::after {
        content: ""; position: absolute; left: 0; bottom: -3px; height: 2px; width: 100%;
        background: var(--orange); transform: scaleX(0); transform-origin: left;
        transition: transform .25s;
      }
      .nav__links a:hover::after { transform: scaleX(1); }

      /* Inhalt */
      .legal {
        max-width: 820px; margin: 0 auto;
        padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.2rem, 5vw, 3rem) clamp(3.5rem, 8vw, 6rem);
      }
      .legal__back {
        display: inline-block; margin-bottom: 2rem;
        color: var(--blue); text-decoration: none; font-weight: 600; font-size: 0.95rem;
      }
      .legal__back:hover { color: var(--orange-text); }
      .legal__title {
        font-family: "Instrument Serif", serif; font-weight: 400;
        font-size: clamp(2.6rem, 6vw, 4.2rem); line-height: 1;
        margin: 0 0 2.5rem; color: var(--ink);
      }

      .legal__prose h2 {
        font-family: "Instrument Serif", serif; font-weight: 400;
        font-size: clamp(1.8rem, 3.5vw, 2.4rem); line-height: 1.1;
        color: var(--orange); margin: 3rem 0 1rem;
        padding-top: 1.6rem; border-top: 2px dotted var(--line);
      }
      .legal__prose h2:first-child { margin-top: 0; padding-top: 0; border-top: none; }
      .legal__prose h3 {
        font-family: "Instrument Serif", serif; font-weight: 400;
        font-size: 1.5rem; color: var(--ink); margin: 2.2rem 0 0.7rem;
      }
      .legal__prose h4 {
        font-size: 1.05rem; font-weight: 700; color: var(--ink); margin: 1.8rem 0 0.5rem;
      }
      .legal__prose p, .legal__prose li { color: var(--ink-soft); }
      .legal__prose p { margin: 0 0 1rem; }
      .legal__prose strong { color: var(--ink); }
      .legal__prose a { color: var(--blue); font-weight: 500; word-break: break-word; }
      .legal__prose a:hover { color: var(--orange-text); }
      .legal__prose ul { margin: 0 0 1rem; padding-left: 1.3rem; }
      .legal__prose li { margin-bottom: 0.5rem; }
      .legal__prose address {
        font-style: normal; margin: 0 0 1rem; padding: 1.1rem 1.3rem;
        background: #fff; border: 2px solid var(--ink); border-radius: 14px;
        box-shadow: 4px 4px 0 var(--ink); color: var(--ink); display: inline-block; min-width: min(100%, 20rem);
      }
      .legal__prose address a { display: inline; }

      /* footer (wie Hauptseite, ohne Riesen-Wortmarke) */
      .footer { background: var(--ink); color: var(--cream); padding: clamp(2rem, 4vw, 3rem) clamp(1.2rem, 5vw, 3rem) 2rem; }
      .footer__row { max-width: var(--maxw); margin: 0 auto; display: flex; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; align-items: center; }
      .footer__row p { margin: 0; opacity: 0.8; }
      .footer__links { display: flex; gap: 1.6rem; flex-wrap: wrap; }
      .footer__links a { color: var(--cream); text-decoration: none; font-weight: 500; }
      .footer__links a:hover { color: var(--orange); }
      .footer__copy { max-width: var(--maxw); margin: 1.6rem auto 0; text-align: center; opacity: 0.6; font-size: 0.85rem; }

      @media (max-width: 900px) {
        .nav__links { display: none; }
      }
      @media (max-width: 520px) {
        .footer__row { flex-direction: column; align-items: flex-start; }
        .nav__cta { display: none; }
      }
    </style>
  </body>
</html>
